#version 310 es
precision highp float;
precision highp int;
precision highp sampler2D;
precision highp sampler3D;
#ifndef LINEAR_GROUP
#define LINEAR_GROUP 256
#endif
layout(local_size_x=LINEAR_GROUP) in;
struct Material{vec4 src;vec4 physical;vec4 random;};
struct State{vec4 pos;vec4 vel;};
layout(std430,binding=0) readonly buffer A{Material particles[];};
layout(std430,binding=1) readonly buffer B{State states[];};
layout(std430,binding=3) readonly buffer C{float compression[];};
// 累积缓冲在这里按**标量数组**声明，`k*4+c` 与 `ivec4 accumulation[k][c]` 是同一批字节
// （std430 下 ivec4 的步长就是 16 字节），读它的 `peel-blur.comp` 仍按 ivec4 取。
// 必须是标量：Maleoon 910 上对**向量分量**做 `atomicAdd` 不按数组下标寻址，十万片的贡献
// 全部落进第 0 格——2026-09-17 实测那台上整条压力投影因此恒为空（见第四批文档）。
layout(std430,binding=4) buffer D{int accumulation[];};
#ifdef ACTIVE_REGION
layout(std430,binding=7) buffer W{uint group_count,group_y,group_z,group_pad;ivec4 region,previous;
 int box_x0,box_y0,box_x1,box_y1;ivec2 tiles[];};
#endif
uniform int pass,count,grid_count;
uniform ivec2 grid_shape;
uniform vec2 card,wind;
uniform vec4 grid_bounds;
uniform float span,time,touch_strength;
uniform sampler2D foreground;
uint hash32(uint x){x^=x>>16u;x*=0x7feb352du;x^=x>>15u;x*=0x846ca68bu;return x^(x>>16u);}
float unit32(uint x){return float(hash32(x)>>8u)*(1./16777216.);}
void main(){
 uint i=gl_GlobalInvocationID.x;
 // 清零默认保持整网格：它只是每格写 16 字节，Adreno 上实测落在噪声里。
 // M4（第二阶段）：`CLEAR_ACTIVE_REGION` 让它只清活动区域。**不变式**：本帧写到的格子
 // 都在本帧包围盒内，而下一帧清的是「上一帧包围盒 ∪ 本帧包围盒」外扩一个 tile 的区域，
 // 必然覆盖它；区域外的格子从初始化起就没人写过。构造与切换形态时 region 是整网格。
 if(pass==0){if(i<uint(grid_shape.x*grid_shape.y)){
#if defined(ACTIVE_REGION) && defined(CLEAR_ACTIVE_REGION)
  ivec2 c=ivec2(int(i)%grid_shape.x,int(i)/grid_shape.x);
  if(any(lessThan(c,region.xy))||any(greaterThan(c,region.zw)))return;
#endif
  int b=int(i)*4;accumulation[b]=0;accumulation[b+1]=0;accumulation[b+2]=0;accumulation[b+3]=0;}return;}
 if(i>=uint(count))return;Material m=particles[i];float age=time-m.src.z;
 if(m.src.w>=float(grid_count)||age<=0.||age>=m.physical.z)return;
 ivec2 source=clamp(ivec2(m.src.xy/card*vec2(textureSize(foreground,0))),ivec2(0),textureSize(foreground,0)-1);
 float opacity=texelFetch(foreground,source,0).a;
 if(opacity<=0.)return;
 vec2 p=m.src.xy+(states[i].pos.xy-m.src.xy)/(.55+.90*touch_strength);
 vec2 peel=-m.physical.xy;
 peel-=wind*min(dot(peel,wind),0.);peel-=wind*max(dot(peel,wind),0.)*.82;
 vec2 edge=min(m.src.xy,card-m.src.xy);
 vec2 outside=vec2(m.src.x<card.x*.5?-1.:1.,m.src.y<card.y*.5?-1.:1.)*exp(-edge/(span*.13));
 float eject=max(dot(normalize(outside+vec2(.000001)),normalize(peel+vec2(.000001))),0.);
 peel*=1.-.95*eject*exp(-min(edge.x,edge.y)/(span*.18));
 float response=unit32(floatBitsToUint(m.random.x)^floatBitsToUint(m.random.y)^0xa54ff53au);
 float strength=1.2141309*(.10+1.80*response);
 float pressure=2.*compression[i]*.16*strength;
 peel*=strength/(1.+pressure*pressure/(1.+pressure));
 peel*=exp(-age/.16)*smoothstep(.003,.028,age);
 float mass=opacity*(1.-smoothstep(m.physical.z-.075,m.physical.z,age));
 vec2 q=(p-grid_bounds.xy)/grid_bounds.zw*vec2(grid_shape)-.5;
 ivec2 lo=ivec2(floor(q));vec2 f=fract(q);
#ifdef ACTIVE_REGION
 // 本帧真正写到的格子（双线性的 2×2 与网格的交集）记进包围盒；整块都在网格外就不记，
 // 否则一片飞得很远的粒子会把区域无谓地撑大。
 //
 // 两条讲究，都是为了**别把十万个线程压到同四个地址上**（2026-09-17 实测：无条件原子让
 // 整段压力更新贵 4%–12%，比省下来的还多）：
 // ① 记的是 **16 格 tile 的坐标**，不是格坐标——同一个 tile 里的所有片给出同一个值；
 // ② 先用**普通读**看一眼当前包围盒，已经覆盖就完全不发原子。包围盒只会单调外扩，
 //    读到的哪怕是旧值也只会让判定偏保守（多发一次原子），永远不会漏掉该记的格。
 if(lo.x+1>=0&&lo.y+1>=0&&lo.x<grid_shape.x&&lo.y<grid_shape.y){
  ivec2 clo=clamp(lo,ivec2(0),grid_shape-1)/16,chi=clamp(lo+1,ivec2(0),grid_shape-1)/16;
  if(clo.x<box_x0)atomicMin(box_x0,clo.x);
  if(clo.y<box_y0)atomicMin(box_y0,clo.y);
  if(chi.x>box_x1)atomicMax(box_x1,chi.x);
  if(chi.y>box_y1)atomicMax(box_y1,chi.y);
 }
#endif
#ifdef NEAREST_SPLAT
 // U8：最近格 splat，每片原子 12 → 3。splat 之后紧跟两遍 σ≈1.2 格的高斯，
 // 双线性额外给的约 0.4 格平滑基本冗余（V 级，要看图定夺）。
 ivec2 cell=ivec2(floor(q+.5));
 if(!(any(lessThan(cell,ivec2(0)))||any(greaterThanEqual(cell,grid_shape)))){
  int k=(cell.y*grid_shape.x+cell.x)*4;
  atomicAdd(accumulation[k],int(round(peel.x*mass*4096.)));
  atomicAdd(accumulation[k+1],int(round(peel.y*mass*4096.)));
  atomicAdd(accumulation[k+2],int(round(mass*4096.)));
 }
#else
 for(int dy=0;dy<2;dy++)for(int dx=0;dx<2;dx++){
  ivec2 cell=lo+ivec2(dx,dy);if(any(lessThan(cell,ivec2(0)))||any(greaterThanEqual(cell,grid_shape)))continue;
  float w=mass*(dx==0?1.-f.x:f.x)*(dy==0?1.-f.y:f.y);
  int k=(cell.y*grid_shape.x+cell.x)*4;
  atomicAdd(accumulation[k],int(round(peel.x*w*4096.)));
  atomicAdd(accumulation[k+1],int(round(peel.y*w*4096.)));
  atomicAdd(accumulation[k+2],int(round(w*4096.)));
 }
#endif
}
