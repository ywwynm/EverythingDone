#version 310 es
precision highp float;
precision highp int;
precision highp sampler2D;
// U2b：三维采样器的精度。`texelFetch` 用整数坐标，坐标精度与它无关；数据本身是
// f16 与 u8，mediump 存得下。Arm 第 8.4 节：highp 采样器可能只有一半速度。
#ifdef MEDIUMP_SAMPLER
precision mediump sampler3D;
#else
precision highp sampler3D;
#endif
// M1：Mali 族的一维工作组变体。dispatch 除数由 Kotlin 侧的 linearGroups() 跟着走。
#ifndef LINEAR_GROUP
#define LINEAR_GROUP 256
#endif
layout(local_size_x=LINEAR_GROUP) in;
struct Material {vec4 src; vec4 physical; vec4 random;};
struct State {vec4 pos;vec4 vel;};
layout(std430,binding=0) readonly buffer A {Material particles[];};
layout(std430,binding=1) buffer B {State state[];};
layout(std430,binding=3) readonly buffer PeelCompression {float peel_compression[];};
uniform int count;
uniform float time,dt,span,wind_gain,curl_gain,roll_gain;
uniform vec2 wind;
uniform sampler3D guide_field;
uniform sampler2D peel_field;
uniform vec4 peel_bounds;
#ifdef PEEL_FIELD_HALF
// U3：修正场改 RGBA16F + 硬件双线性。显式 4 点的钳位区间恰好就是 CLAMP_TO_EDGE 的行为
// （纹素中心 [0.5/size, 1-0.5/size]），所以直接按归一化坐标取一次即可，权重由硬件给。
vec2 sample_peel(vec2 p){
    return texture(peel_field,(p-peel_bounds.xy)/peel_bounds.zw).xy;
}
#else
vec2 sample_peel(vec2 p){
    ivec2 size=textureSize(peel_field,0);
    vec2 q=clamp((p-peel_bounds.xy)/peel_bounds.zw*vec2(size)-.5,vec2(0),vec2(size-1));
    ivec2 a=ivec2(floor(q)),b=min(a+1,size-1);vec2 f=fract(q);
    return mix(mix(texelFetch(peel_field,a,0).xy,texelFetch(peel_field,ivec2(b.x,a.y),0).xy,f.x),
               mix(texelFetch(peel_field,ivec2(a.x,b.y),0).xy,texelFetch(peel_field,b,0).xy,f.x),f.y);
}
#endif
uniform sampler3D confidence_field;
#ifdef MERGED_FIELD
// U2：流场（.xy）与置信度（.z）合成一张 RGBA16F，`field_cell` 的取样 2 → 1。
uniform sampler3D merged_field;
#endif
uniform vec2 card,guide_rotation;
uniform float guide_gain,touch_gap,touch_strength;
uniform vec4 field_geometry;
uniform vec4 variation_affine,variation_bend,variation_wave;
uniform vec2 variation_clock;
#ifdef SINK
// 碰一碰：消散的终点（NFC 天线位置），材料坐标。每片寿命已在 CPU 侧改成「出生到抵达终点」。
uniform vec2 sink_point;
uniform float sink_swirl;
// 转向终点的过渡区间（飞行进度）：smoothstep(.x, .y, 进度)。
uniform vec2 sink_homing;
// 第二组终点：屏幕边框（left, top, right, bottom），一部分微片流向离它最近的那条边。
// sink_frame_mix.x 是流向边框的占比（0 = 全部流向 sink_point），.y 是沿边错开的全幅。
uniform vec4 sink_frame;
uniform vec2 sink_frame_mix;
// 与 ParticleSink.target 逐项对应（同样的随机数、同样的比较顺序），CPU 按它改写寿命。
vec2 sink_target(Material m){
    float pick=fract(m.random.x*7.31+m.random.w*3.17);
    if(pick>=sink_frame_mix.x)return sink_point;
    vec2 q=m.src.xy;
    float jitter=(fract(m.random.y*5.13+m.random.z*1.91)-.5)*sink_frame_mix.y;
    float left=q.x-sink_frame.x,right=sink_frame.z-q.x;
    float top=q.y-sink_frame.y,bottom=sink_frame.w-q.y;
    float nearest=min(min(left,right),min(top,bottom));
    if(nearest==left)return vec2(sink_frame.x,clamp(q.y+jitter,sink_frame.y,sink_frame.w));
    if(nearest==right)return vec2(sink_frame.z,clamp(q.y+jitter,sink_frame.y,sink_frame.w));
    if(nearest==top)return vec2(clamp(q.x+jitter,sink_frame.x,sink_frame.z),sink_frame.y);
    return vec2(clamp(q.x+jitter,sink_frame.x,sink_frame.z),sink_frame.w);
}
#ifdef SINK_FIELD
// 柔性终点（2026-09-25 起的碰一碰）：不再让每一片都在寿命末端收进同一点。
// 流向天线的颗粒只有 sink_flow.y 这一份被吸入：各自落在天线周围半径 sink_flow.z 的圆盘里，
// 沿等角螺线旋入（sink_flow.x = 切向 / 径向）；其余按弹窗的方式随风消散，只朝天线漂移
// （sink_flow.w，每秒若干短边）。流向边框的颗粒落在边框向内 sink_band.x 宽的带里，
// 途中带一点螺旋（sink_band.y）与卷流（sink_band.z）。
uniform vec4 sink_flow;
uniform vec4 sink_band;
// 涡旋核半径（材料单位）：切向分量乘 r²/(d²+r²)，远处基本直奔，靠近天线才旋入
uniform float sink_vortex;
// 整团滑行：牵引按绝对时间在 [.x, .y] 里渐入（不按各自的飞行进度），所以先剥离的颗粒不会先飞走，
// 整团尘云一起动身；.z 是接近增益（>1 时先快后慢地落定）
uniform vec3 sink_glide;
// 多张卡片同时拼出时按卡片分组（快照里的矩形，材料坐标），每组各有：.x 牵引时间窗的平移（秒，
// 与这一组的抵达时间窗同向平移）、.y 切向分量的倍数、.z 流向边框的占比。不分组时 count = 0。
// 让几张卡片错开时间、走不同的弧、取不同的来源，不再左右对称。
uniform vec4 sink_groups[4];
uniform vec4 sink_group_params[4];
uniform int sink_group_count;
vec4 sink_group(Material m){
    for(int g=0;g<4;g++){
        if(g>=sink_group_count)break;
        vec4 r=sink_groups[g];
        if(m.src.x>=r.x&&m.src.y>=r.y&&m.src.x<r.z&&m.src.y<r.w)return sink_group_params[g];
    }
    return vec4(0.,1.,sink_frame_mix.x,0.);
}
bool sink_frame_bound(Material m){return fract(m.random.x*7.31+m.random.w*3.17)<sink_group(m).z;}
bool sink_absorbed(Material m){return fract(m.random.z*4.73+m.random.y*8.21)<sink_flow.y;}
vec2 sink_field_target(Material m){
    if(sink_frame_bound(m)){
        // 从快照中心沿「中心 → 这一片」的方向射到边框上：整圈边框都有颗粒流入，多张卡片时
        // 左边的卡片取左半圈、右边的取右半圈；再沿边错开、在带宽内向里散开
        vec2 c=card*.5;
        vec2 u=m.src.xy-c;
        float len=length(u);
        u=len>.0001?u/len:vec2(0.,1.);
        float tx=u.x>.0001?(sink_frame.z-c.x)/u.x:u.x<-.0001?(sink_frame.x-c.x)/u.x:1e9;
        float ty=u.y>.0001?(sink_frame.w-c.y)/u.y:u.y<-.0001?(sink_frame.y-c.y)/u.y:1e9;
        bool side=tx<ty;
        vec2 hit=c+u*min(tx,ty);
        float jitter=(fract(m.random.y*5.13+m.random.z*1.91)-.5)*sink_frame_mix.y;
        hit+=(side?vec2(0.,1.):vec2(1.,0.))*jitter;
        hit=clamp(hit,sink_frame.xy,sink_frame.zw);
        vec2 inward=side?vec2(u.x>0.?-1.:1.,0.):vec2(0.,u.y>0.?-1.:1.);
        // 带里外侧密、内侧疏（与光尘带的扩散分布一致）
        return hit+inward*sink_band.x*pow(fract(m.random.y*3.93+m.random.x*6.11),1.6);
    }
    // 天线周围的落点：瑞利分布（二维高斯的半径），向外逐渐变稀，没有一圈整齐的边
    float angle=fract(m.random.y*3.71+m.random.x*5.27)*6.28318;
    float u=fract(m.random.z*9.13+m.random.w*2.39);
    float radius=min(.55*sqrt(-2.*log(max(1.-u,.0001))),2.2)*sink_flow.z;
    return sink_point+vec2(cos(angle),sin(angle))*radius;
}
#ifdef SINK_TARGETS
// 交接（2026-09-25 第三版，模拟器先行）：逐片指定终点。接收时屏幕四周扩散进来的光尘就近接手一部分流向四边
// 的颗粒，倒放时这些颗粒从那片光尘的位置出现（.z = 2，按流向边框的颗粒运动）；.z = 1 按流向天线的颗粒运动
// （现在没有用到）；.z = 0 照旧按 sink_field_target。.xy 是材料坐标。绑定点用 2：GLES 3.1 只保证 4 个存储
// 缓冲绑定点，积分器此外只用 0、1、3。
layout(std430,binding=2) readonly buffer SinkTargets {vec4 sink_explicit[];};
// 被接手的颗粒不按弹窗的风向先飞出去再折回：剥离之后牵引就按各自的年龄渐入（.x，粒子时间），
// 直接滑向终点；途中卷流的倍数（.y）与取样频率（.z，1.37 即其余颗粒的尺度，越大卷得越碎）
uniform vec4 sink_handoff;
#endif
#endif
#endif

// A1（第二阶段）：`curl()` 的**方向向量**那几步改 mediump；相位（a/b）留 highp，
// 因为 dot(p,u)/scale*6.283 的量级由卡片尺寸决定，fp16 会把 sin 的自变量打散。
#ifdef MEDIUMP_ALU
#define MP mediump
#else
#define MP
#endif
vec2 curl(vec2 p,float t) {
    MP vec2 v=vec2(0);
    for(int k=0;k<3;k++) {
        float scale=span*(k==0?1.12:k==1?.51:.23);
        float angle=atan(wind.y,wind.x)+.61+float(k)*1.71;
        MP vec2 u=vec2(cos(angle),sin(angle)),z=vec2(-u.y,u.x);
        float a=dot(p,u)/scale*6.283+t*(1.2+float(k)*.5)+variation_wave.z;
        float b=dot(p,z)/scale*6.283-t*(.8+float(k)*.43)+variation_wave.w;
        // 同一个连续势场的二维旋度；各频段幅值递减。
        MP vec2 grad=(cos(a)*cos(b)*u-sin(a)*sin(b)*z);
        v+=vec2(grad.y,-grad.x)*(k==0?1.:k==1?.38:.12);
    }
    return v;
}
vec2 local_anchor(float index){
    float along=index*span*.96*field_geometry.z;
    float across=span*.16*field_geometry.z*sin(index*2.4+variation_wave.z);
    vec2 axis=mix(vec2(1,0),vec2(0,1),field_geometry.w);
    return axis*along+vec2(-wind.y,wind.x)*across;
}
#ifdef MERGED_FIELD
vec3 field_cell(ivec3 cell){return texelFetch(merged_field,cell,0).xyz;}
#define FIELD_SIZE textureSize(merged_field,0)
#else
vec3 field_cell(ivec3 cell){
    return vec3(texelFetch(guide_field,cell,0).xy,texelFetch(confidence_field,cell,0).r);
}
#define FIELD_SIZE textureSize(guide_field,0)
#endif
#if defined(PROBE_SINGLE_CELL)
// 归因专用：只取一个格子、不做三线性。**画面必然错**，只用来量那 32 次取样的份额。
vec3 sample_field(vec3 uvw){
    ivec3 size=FIELD_SIZE;
    return field_cell(ivec3(clamp(uvw*vec3(size)-.5,vec3(0),vec3(size-1))));
}
#elif defined(HARDWARE_TRILINEAR)
// U10：交给硬件三线性，取样 16 → 1（合并流场时）。钳位区间与显式版本一致
// （CLAMP_TO_EDGE），但**插值权重由各家硬件决定**，跨设备不再逐位可比。
vec3 sample_field(vec3 uvw){
#ifdef MERGED_FIELD
    return texture(merged_field,uvw).xyz;
#else
    return vec3(texture(guide_field,uvw).xy,texture(confidence_field,uvw).r);
#endif
}
#else
vec3 sample_field(vec3 uvw){
    ivec3 size=FIELD_SIZE;
    vec3 q=clamp(uvw*vec3(size)-.5,vec3(0),vec3(size-1));
    ivec3 a=ivec3(floor(q)),b=min(a+1,size-1);
    vec3 f=fract(q);
    // 显式三线性插值，使桌面和移动 GPU 使用同一浮点权重。
    vec3 z0=mix(mix(field_cell(a),field_cell(ivec3(b.x,a.y,a.z)),f.x),
                mix(field_cell(ivec3(a.x,b.y,a.z)),field_cell(ivec3(b.x,b.y,a.z)),f.x),f.y);
    vec3 z1=mix(mix(field_cell(ivec3(a.x,a.y,b.z)),field_cell(ivec3(b.x,a.y,b.z)),f.x),
                mix(field_cell(ivec3(a.x,b.y,b.z)),field_cell(b),f.x),f.y);
    return mix(z0,z1,f.z);
}
#endif
vec3 guided_flow(vec2 p,vec2 anchor,float t){
    vec2 cq=(p-card*.5-anchor)/field_geometry.xy;
    float ca=guide_rotation.x,sa=guide_rotation.y;
    vec2 local=vec2(ca*cq.x-sa*cq.y,sa*cq.x+ca*cq.y);
    vec2 wave=vec2(variation_wave.y*local.y+variation_wave.z,variation_wave.x*local.x+variation_wave.w);
    vec2 lookup=vec2(.5)+variation_affine.xy*local+variation_affine.zw*local.yx+variation_bend.xy+variation_bend.zw*sin(wave);
    float field_time=t+t*(1.-t)*(variation_clock.x+variation_clock.y*(2.*t-1.));
    float clock_rate=1.+variation_clock.x*(1.-2.*t)+variation_clock.y*(-6.*t*t+6.*t-1.);
    vec3 uvw=vec3((lookup+vec2(.45))/1.9,field_time);
    vec3 sampled=sample_field(uvw);
    vec2 guide=sampled.xy;
    float confidence=sampled.z;
    // 速度也通过同一空间变换的逆导数换回，保留释放与卷动之间的关系。
    vec2 cross_terms=variation_affine.zw+variation_bend.zw*variation_wave.yx*cos(wave);
    float determinant=variation_affine.x*variation_affine.y-cross_terms.x*cross_terms.y;
    guide=vec2(variation_affine.y*guide.x-cross_terms.x*guide.y,-cross_terms.y*guide.x+variation_affine.x*guide.y)/determinant*clock_rate;
    guide=vec2(ca*guide.x+sa*guide.y,-sa*guide.x+ca*guide.y)*field_geometry.xy;
    return vec3(guide,confidence);
}

// 输运随机量与寿命随机量分离，避免长寿命片集中在较慢的一条轨迹上。
uint transport_hash(uint x){x^=x>>16u;x*=0x7feb352du;x^=x>>15u;x*=0x846ca68bu;return x^(x>>16u);}
float transport_unit(uint x){return float(transport_hash(x)>>8u)*(1./16777216.);}

void main(){
    uint i=gl_GlobalInvocationID.x;if(i>=uint(count))return;
    Material m=particles[i];
    float age=time-m.src.z;
    if(age<=0.){state[i].pos=vec4(m.src.xy,0,0);state[i].vel=vec4(0);return;}
    float h=min(dt,age);
    // 距离改变各自出生位置之外的运动幅度；共同流动在材料坐标中连续积分。
    // 先还原坐标再取流场，避免不同速度又把密集边缘压回相似位置。
    float distance_gain=.55+.90*touch_strength;
    vec2 p=m.src.xy+(state[i].pos.xy-m.src.xy)/distance_gain;
    float t=clamp(time-m.physical.w,0.,1.);
    vec2 source=m.src.xy-card*.5;
    float coordinate=mix(source.x,source.y,field_geometry.w)/(span*.96);
    float index=floor(coordinate);
    float weight=smoothstep(0.,1.,coordinate-index);
    vec3 sample0=guided_flow(p,local_anchor(index),t);
    if(field_geometry.z>.00001)sample0=mix(sample0,guided_flow(p,local_anchor(index+1.),t),weight);
    // 背景触点由真实方向及边缘外距离还原，直接参与每片的速度计算。
    float reach=1.-exp(-.65/.85);
    float carried=smoothstep(.012,.16,age);
    vec2 q=p-card*.5-wind*span*(.43*time+.16*time*time);
    vec2 flow=curl(q,time)*span*curl_gain;
    float missing=1.-smoothstep(.12,.85,sample0.z);
    vec2 target=sample0.xy*(guide_gain/.9)*(1.08+.12*reach);
    target+=flow*mix(.018,.44+.06*reach,missing)*smoothstep(.01,.09,age);
    // 每片继续采样随流迁移的空间场；顺风剪切与卷动共同改变轮廓。
    target+=wind*span*(.12+.50*reach)*carried*wind_gain;
    // 出生位置到触点只决定温和偏转，不随当前位置收敛到目标点。
    float edge=min(card.x/(2.*max(abs(wind.x),.000001)),card.y/(2.*max(abs(wind.y),.000001)));
    vec2 destination=card*.5+wind*(edge+span*touch_gap);
    vec2 bearing=normalize(destination-m.src.xy);
    float turn=.13*atan(dot(bearing,vec2(-wind.y,wind.x)),dot(bearing,wind));
    target=mat2(cos(turn),sin(turn),-sin(turn),cos(turn))*target;
    float random_angle=m.random.w*6.28318;
    float radius=sqrt(-2.*log(max(m.random.z,.015)));
    float separate=smoothstep(.008,.045,age)*(1.-smoothstep(.16,.32,age));
    target+=vec2(cos(random_angle),sin(random_angle))*radius*span*.045*separate;
    // 刚解除的材料沿局部边界向外展开，随后逐渐跟随共同流动。
    // 法向及释放时间来自同一规则；小幅独立差异使弧边具有厚度。
    // 剥离响应与出生时间独立；保持平均强度，避免同步材料形成窄密度峰。
    uint peel_seed=floatBitsToUint(m.random.x)^floatBitsToUint(m.random.y)^0xa54ff53au;
    float peel_response=transport_unit(peel_seed);
    vec2 peel=-m.physical.xy;
    peel-=wind*min(dot(peel,wind),0.);
    peel-=wind*max(dot(peel,wind),0.)*.82;
    // 自由边界不承受额外朝外的强剥离力；流场和惯性仍可带粒子越过边界。
    vec2 free_edge=min(m.src.xy,card-m.src.xy);
    vec2 free_out=vec2(m.src.x<card.x*.5?-1.:1.,m.src.y<card.y*.5?-1.:1.)*exp(-free_edge/(span*.13));
    float eject=max(dot(normalize(free_out+vec2(.000001)),normalize(peel+vec2(.000001))),0.);
    peel*=1.-.95*eject*exp(-min(free_edge.x,free_edge.y)/(span*.18));
    // 按预计累积压缩柔和减轻局部剥离，防止宽材料区域被压到同一条细线。
    // 原法向、寿命与主流场不变；随机响应越强，越需要避免过度汇聚。
    float peel_pressure=2.*peel_compression[i]*.16*1.2141309*(.10+1.80*peel_response);
    // 弱压缩区域的一阶响应保持原样，强压缩逐渐介入，不产生阈值边界。
    peel/=1.+peel_pressure*peel_pressure/(1.+peel_pressure);
    // 根据当前分布抵消剥离造成的空间汇聚；保留每片原有卷动和相对速度。
    target+=(peel*1.2141309*(.10+1.80*peel_response)*exp(-age/.16)*smoothstep(.003,.028,age)+sample_peel(p))*span;
    // 原表面边缘解除后向开放侧分散，不保留有限支撑的锐利外轮廓。
    vec2 edge_dist=min(m.src.xy,card-m.src.xy);
    vec2 outward=vec2(m.src.x<card.x*.5?-1.:1.,m.src.y<card.y*.5?-1.:1.);
    vec2 edge_weight=exp(-edge_dist/(span*.075));
    vec2 outward_spread=outward*edge_weight;
    float trailing_edge=smoothstep(0.,.6,dot(normalize(outward_spread+vec2(.000001)),m.physical.xy));
    float spread_age=smoothstep(.002,.014,age)*exp(-age/.080)*mix(.12,1.,trailing_edge);
    target+=outward_spread*span*.4*(.05+2.4*m.random.z*m.random.z)*spread_age;
    target+=vec2(-wind.y,wind.x)*span*.12*(m.random.w-.5)*length(edge_weight)*spread_age;
    float forward_front=smoothstep(.20,.85,dot(-m.physical.xy,wind));
    target*=1.-.45*forward_front*(1.-smoothstep(.10,.25,age));
    // 只收减自由边界朝外剥离阶段的独立展开，内部已认可的卷动保持原节奏。
    float independent=1.-.65*eject*exp(-min(free_edge.x,free_edge.y)/(span*.18))*(1.-smoothstep(.10,.25,age));
    uint transport_seed=floatBitsToUint(m.random.y)^floatBitsToUint(m.random.w);
    vec2 transport_random=vec2(transport_unit(transport_seed),transport_unit(transport_seed^0x9e3779b9u));
    target*=1.+0.6496880*(transport_random.x-.5)*smoothstep(.025,.14,age)*independent;
    target+=curl(p+transport_random*span*.4,time)*span*.075*smoothstep(.04,.16,age)*independent;
    float depth_target=-state[i].pos.z*3.*roll_gain;
    // 允许侧向卷动；同一颗粒不沿消逝主方向反弹。
    float axial=dot(target,wind)/span;
    // 平滑下限不产生折线拐点，也不把粒子位置截到任何边界。
    float deficit=.16-axial;
    target+=wind*span*.5*(deficit+sqrt(deficit*deficit+.0064));
#if defined(SINK) && defined(SINK_FIELD)
    {
        float flight=max(m.physical.z,.06);
        float journey=clamp(age/flight,0.,1.);
        bool frame_bound=sink_frame_bound(m);
        vec4 group=sink_group(m);
#ifdef SINK_TARGETS
        vec4 handed=sink_explicit[i];
        bool explicit_goal=handed.z>.5;
        if(explicit_goal)frame_bound=handed.z>1.5;
        vec2 goal=explicit_goal?handed.xy:sink_field_target(m);
#else
        bool explicit_goal=false;
        vec2 goal=sink_field_target(m);
#endif
        if(explicit_goal||frame_bound||sink_absorbed(m)){
            // 等角螺线：径向分量恰好在寿命末端抵达各自的落点，切向分量使路径旋入而不是直线汇聚
            float remaining=max(m.src.z+m.physical.z-time,.016);
            vec2 to=goal-p;
            float d=length(to);
            vec2 dir=to/max(d,.0001);
            // 切向比：远处是 sink_swirl（整团沿缓弧滑行），进入涡旋核（sink_vortex）之后换成 sink_flow.x；
            // sink_flow.x 为 0 时贴近落点只剩径向分量，末段不绕着落点旋转。各组再乘自己的倍数
            float core=sink_vortex*sink_vortex/(d*d+sink_vortex*sink_vortex);
            float spin=(frame_bound?sink_band.y:mix(sink_swirl,sink_flow.x,core))*group.y;
            vec2 home=(dir*sink_glide.z+vec2(-dir.y,dir.x)*spin)*(d/remaining);
            // 途中的卷流随抵达减弱，最后平稳落定
            float curl_gain=sink_band.z,curl_scale=1.37;
#ifdef SINK_TARGETS
            if(explicit_goal){curl_gain*=sink_handoff.y;curl_scale=sink_handoff.z;}
#endif
            home+=curl(p*curl_scale+vec2(17.,-9.),time*1.3)*span*curl_gain*(1.-journey);
            // 刚剥离的颗粒先按弹窗的方式离面，再并入整团的滑行
            float glide=smoothstep(sink_glide.x+group.x,sink_glide.y+group.x,time)*smoothstep(0.,.12,age);
#ifdef SINK_TARGETS
            if(explicit_goal)glide=smoothstep(0.,sink_handoff.x,age);
#endif
            target=mix(target,home,glide);
        }else{
            // 未被吸入的颗粒：弹窗的消散方式，只额外朝天线漂移
            vec2 to=sink_point-p;
            target+=to/max(length(to),.0001)*span*sink_flow.w*smoothstep(.04,.30,age);
        }
    }
#elif defined(SINK)
    {
        // 剥离初段仍按上面的剥离与流场走；随后逐渐转向终点，剩余时间越少拉得越紧，
        // 在寿命末端恰好抵达（寿命的淡出同时发生），看上去就是整股流被吸进那一点。
        float flight=max(m.physical.z,.06);
        float journey=clamp(age/flight,0.,1.);
        float remaining=max(m.src.z+m.physical.z-time,.016);
        vec2 to_sink=sink_target(m)-p;
        vec2 homing=to_sink/remaining;
        // 绕终点的切向分量把流束弯成弧线汇入，越接近终点越弱，最后径直收进去
        homing+=vec2(-to_sink.y,to_sink.x)/remaining*sink_swirl*(1.-journey);
        target=mix(target,homing,smoothstep(sink_homing.x,sink_homing.y,journey));
    }
#endif
    // 共享速度场已向无有效观测的空间延拓。位置继续积分，
    // 控件轮廓、观测范围和屏幕边缘都不构成碰撞或速度归零条件。
    float response=1.-exp(-h/(.018+.036*m.random.z));
    vec2 old_v=state[i].vel.xy/distance_gain;
    if(age<=dt)old_v=target*.85;
    vec2 v=mix(old_v,target,response);
    // 保存真实屏幕运动，渲染外推、Android 及状态验收均使用同一位移与速度。
    state[i].pos.xy=m.src.xy+(p+v*h-m.src.xy)*distance_gain;
    state[i].vel.xy=v*distance_gain;
    float vz=mix(state[i].vel.z,depth_target,response);
    state[i].pos.z+=vz*h;
    state[i].vel.z=vz;
}
