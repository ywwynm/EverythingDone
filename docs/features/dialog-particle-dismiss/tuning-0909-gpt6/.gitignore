# 源码和必要参数入库，其余素材、输出及历史版本保留本地。
# conditional-transport-weights.json、particle-scatter-weights.json 是约 2 MB 的拟合权重（旧候选模型用），只留本地。
/*
!/.gitignore
!/.gitattributes
!/*.py
!/*.ps1
!/README.md
!/v2_inputs.json
!/conditional-release-weights.json
!/conditional-material-rules.json
!/surface-transfer-rules.json
!/particle-coverage-rules.json
!/particle-cohort-weights.json
!/surface-coherence-weights.json
!/native_reference_inputs.json
!/analysis/
/analysis/*
!/analysis/*.py
!/analysis/common-shape-calibration.json
!/analysis/filament-cohort.json
!/live/
/live/*
!/live/live_server.py
!/live/live.html
!/live/test_preview.py
!/live/README.md
!/live/preview_gateway.py
!/live/latest.json
!/live/test_gateway.py
!/research/
/research/*
!/research/*.py
!/assets/
/assets/*
!/assets/scenes.json
!/assets/*/
/assets/*/*
!/assets/*/scene.json
!/assets/*/profile.json
!/assets/*/flow-profile.json
