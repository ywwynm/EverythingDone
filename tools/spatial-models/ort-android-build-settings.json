{
  "build_abis": [
    "armeabi-v7a",
    "arm64-v8a",
    "x86",
    "x86_64"
  ],
  "android_min_sdk_version": 26,
  "android_target_sdk_version": 36,
  "build_params": [
    "--enable_lto",
    "--android",
    "--parallel",
    "--cmake_generator=Ninja",
    "--build_java",
    "--build_shared_lib",
    "--disable_ml_ops",
    "--cmake_extra_defines=onnxruntime_BUILD_UNIT_TESTS=OFF",
    "--compile_no_warning_as_error",
    "--skip_tests"
  ]
}
