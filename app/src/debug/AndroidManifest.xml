<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <instrumentation android:name=".detail.ThingDetailTransitionProbe"
        android:targetPackage="${applicationId}" android:label="卡片展开详情及原数据完整性回归" />
    <instrumentation android:name=".views.particledismiss.ParticleDefaultDirectionProbe"
        android:targetPackage="${applicationId}" android:label="隔离数据的消散方向回归" />
    <instrumentation android:name=".covergeneration.CoverGenerationInteractionProbe"
        android:targetPackage="${applicationId}" />
    <instrumentation android:name=".covergeneration.CoverGenerationProbe"
        android:targetPackage="${applicationId}" android:label="动态封面生成与单行布局回归" />
    <instrumentation android:name=".detail.DetailToolbarContrastProbe"
        android:targetPackage="${applicationId}" android:label="详情顶栏滚动配色回归" />
    <instrumentation android:name=".listvalidation.ListIdentityProbe"
        android:targetPackage="${applicationId}" android:label="隔离数据的完成恢复删除身份回归" />
    <instrumentation android:name=".views.particledismiss.DoingBackgroundRegressionProbe"
        android:targetPackage="com.ywwynm.everythingdone" android:label="做事背景、横竖屏和动画回归" />
    <instrumentation android:name=".notification.NoticeableNotificationScrollProbe"
        android:targetPackage="com.ywwynm.everythingdone" android:label="通知弹窗真实窗口滚动回归" />
    <instrumentation android:name=".notification.ThingNotificationClickProbe"
        android:targetPackage="${applicationId}" android:label="通知点击目标、设置与粒子进入回归" />
    <!-- 碰一碰快速入组失败后的普通 Wi-Fi 兼容试验，仅调试包启用。 -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <instrumentation android:name=".views.particledismiss.SelectionBatchTransitionProbe"
        android:targetPackage="${applicationId}" android:label="隔离数据的真实首页批量转场回归" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <instrumentation android:name=".views.particledismiss.ParticleTuningShadowProbe"
        android:targetPackage="com.ywwynm.everythingdone" android:label="设置页卡片阴影回归" />

    <instrumentation android:name=".localization.LocalizationProbe"
        android:targetPackage="com.ywwynm.everythingdone" android:label="多语言文案与日期数量回归" />

    <instrumentation android:name=".taptransfer.TapReceiveVisibilityProbe"
        android:targetPackage="com.ywwynm.everythingdone" android:label="碰一碰接收卡片显示回归" />

    <instrumentation android:name=".taptransfer.TapDetailUpdateProbe"
        android:targetPackage="com.ywwynm.everythingdone" android:label="碰一碰更新详情回归" />

    <instrumentation android:name=".views.particledismiss.AppearancePanelInputProbe"
        android:targetPackage="com.ywwynm.everythingdone" android:label="外观面板交接回归" />

    <instrumentation android:name=".views.particledismiss.ParticlePresentationRegressionProbe"
        android:targetPackage="com.ywwynm.everythingdone" android:label="粒子显示虚构场景回归" />

    <instrumentation android:name=".views.particledismiss.ParticleFlowTimingProbe"
        android:targetPackage="com.ywwynm.everythingdone" />
    <instrumentation android:name=".views.particledismiss.ParticleFlowProgramsProbe"
        android:targetPackage="com.ywwynm.everythingdone" />
    <instrumentation android:name=".views.particledismiss.ParticleContentSamplesProbe"
        android:targetPackage="com.ywwynm.everythingdone" android:label="粒子内容原始像素逐位对照" />

    <instrumentation android:name=".views.particledismiss.ParticlePageCompositeProbe"
        android:targetPackage="com.ywwynm.everythingdone" android:label="整页合成像素对照" />

    <instrumentation android:name=".views.particledismiss.ParticleClockPathProbe"
        android:targetPackage="com.ywwynm.everythingdone" android:label="计时路径缓存像素对照" />

    <instrumentation android:name=".views.particledismiss.ParticleBusinessRegressionProbe"
        android:targetPackage="com.ywwynm.everythingdone" android:label="已有记事粒子显示只读验证" />

    <instrumentation android:name=".interaction.UiInteractionInputProbe"
        android:targetPackage="com.ywwynm.everythingdone" android:label="界面交互互斥回归" />

    <instrumentation android:name=".detail.DetailLayoutRegressionProbe"
        android:targetPackage="com.ywwynm.everythingdone" android:label="详情布局迁移回归" />
    <instrumentation android:name=".detail.DetailPerformanceProbe"
        android:targetPackage="com.ywwynm.everythingdone" android:label="指定长清单性能对照" />
    <instrumentation android:name=".detail.DetailAppearanceLatencyProbe"
        android:targetPackage="com.ywwynm.everythingdone" android:label="指定附件外观入口延迟诊断" />
    <instrumentation android:name=".detail.DetailRecreationProbe"
        android:targetPackage="com.ywwynm.everythingdone" android:label="详情重建状态差分" />
    <instrumentation android:name=".detail.DetailMediaGeometryProbe"
        android:targetPackage="com.ywwynm.everythingdone" android:label="详情媒体默认比例回归" />
    <instrumentation android:name=".detail.DetailMediaOverlayProbe"
        android:targetPackage="com.ywwynm.everythingdone" android:label="详情附件自适应配色及速度验证" />

    <instrumentation android:name=".views.particledismiss.ParticleRecordingAppearanceProbe"
        android:targetPackage="com.ywwynm.everythingdone" android:label="录音准备页粒子交接验证" />
    <application
        android:networkSecurityConfig="@xml/debug_network_security_config"
        android:usesCleartextTraffic="true"
        tools:replace="android:networkSecurityConfig">

        <receiver android:name=".detail.DetailTransitionTimingReceiver"
            android:exported="true" android:permission="android.permission.DUMP"/>
        <activity android:name=".views.recording.fablesol.FableSolHdrCompositionActivity"
            android:enabled="false" android:exported="false"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <activity android:name=".covergeneration.CoverRecoveryProbeActivity"
            android:exported="false" android:launchMode="singleTask"
            android:theme="@style/EverythingDoneTheme.Settings" />
        <activity android:name=".covergeneration.CoverGenerationProbeActivity"
            android:exported="false" android:theme="@style/EverythingDoneTheme.Settings" />
        <activity android:name=".listvalidation.GifLifecycleActivity"
            android:exported="false" android:excludeFromRecents="true"
            android:theme="@style/EverythingDoneTheme.Settings" />

        <activity android:name=".notification.NoticeableNotificationLandscapeProbeActivity"
            android:exported="false" android:excludeFromRecents="true" android:screenOrientation="landscape"
            android:theme="@style/EverythingDoneTheme.NoticeableNotification" />

        <activity android:name=".views.particledismiss.ParticleRippleProbeActivity"
            android:exported="true" android:theme="@style/EverythingDoneTheme.Settings" />

        <activity android:name=".views.particledismiss.ParticlePresentationDiagnosticsActivity"
            android:exported="false" android:theme="@style/EverythingDoneTheme.Settings" />
        <activity android:name=".views.particledismiss.ParticleDirectionFixtureActivity"
            android:exported="false" android:theme="@style/EverythingDoneTheme.Settings" />
        <activity android:name=".views.particledismiss.ParticlePresentationCaseActivity"
            android:exported="false" android:theme="@style/EverythingDoneTheme.Settings" />
        <activity android:name=".views.particledismiss.ParticlePresentationImagesActivity"
            android:exported="false" android:theme="@style/EverythingDoneTheme.Settings" />
        <activity android:name=".views.particledismiss.ParticleDoingProbeActivity"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|uiMode"
            android:screenOrientation="user" android:resizeableActivity="true"
            android:exported="false" android:theme="@style/EverythingDoneTheme.Doing" />

        <activity android:name=".taptransfer.TapReceiveVisibilityActivity"
            android:exported="false" android:excludeFromRecents="true"
            android:theme="@style/EverythingDoneTheme.Things" />

        <activity android:name=".detail.DetailProcessProbeActivity" android:exported="true"
            android:taskAffinity="com.ywwynm.everythingdone.detailregression"
            android:theme="@style/EverythingDoneTheme.TotallyTransparent" />
        <provider android:name=".detail.DetailProcessObserver" android:exported="false"
            android:authorities="${applicationId}.detail-process-observer" />

        <activity android:name=".detail.DetailRegressionCoverActivity"
            android:exported="false" android:excludeFromRecents="true"
            android:theme="@style/EverythingDoneTheme.Settings" />

        <activity android:name=".interaction.InteractionProbeActivity"
            android:exported="false" android:excludeFromRecents="true"
            android:theme="@style/EverythingDoneTheme.Settings" />
        <activity android:name=".interaction.InteractionResultActivity"
            android:exported="false" android:excludeFromRecents="true"
            android:theme="@style/EverythingDoneTheme.Settings" />

        <activity android:name=".views.particledismiss.ThingListRemovalProbeActivity"
            android:exported="true" android:excludeFromRecents="true"
            android:theme="@style/EverythingDoneTheme.Things" />

        <!-- 显式诊断文件开启后仅旁观窗口与输入；不启动 Activity、不派发业务事件。 -->
        <provider android:name=".views.particledismiss.ThingAnimationPerformanceObserver"
            android:authorities="${applicationId}.animation-performance-observer"
            android:exported="false" />

        <!-- 调试专用：旁观真实保存返回，检查列表腾位、粒子和卡片显示的顺序。 -->
        <activity android:name=".views.particledismiss.NewItemAppearanceProbeActivity"
            android:exported="true" android:excludeFromRecents="true"
            android:theme="@style/EverythingDoneTheme.TotallyTransparent" />

        <activity android:name=".views.particledismiss.ParticlePanelReuseProbeActivity"
            android:exported="true" android:excludeFromRecents="true"
            android:theme="@style/EverythingDoneTheme.Things" />

        <!-- 飘散样式：旧钢铁侠与原片的对照（docs/features/harmony-particle-android-port/device/ironman_parity.py） -->
        <activity android:name=".views.particledismiss.DriftParityProbeActivity"
            android:exported="true" android:excludeFromRecents="true"
            android:theme="@style/EverythingDoneTheme.Things" />

        <!-- 飘散样式：离屏逐帧导出，与桌面实现逐帧对照（docs/features/harmony-particle-android-port/parity/） -->
        <activity android:name=".views.particledismiss.DriftParityRenderActivity"
            android:exported="true" android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity
            android:name=".views.particledismiss.ParticleRepeatProbeActivity"
            android:exported="true" android:excludeFromRecents="true"
            android:theme="@style/EverythingDoneTheme.TotallyTransparent" />

        <activity
            android:name=".views.particledismiss.ParticleTransitionProbeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/EverythingDoneTheme.TotallyTransparent" />

        <activity
            android:name=".views.particledismiss.ParticleDialogRouteProbeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/EverythingDoneTheme.TotallyTransparent" />

        <activity
            android:name=".views.particledismiss.ParticleCoverageProbeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/EverythingDoneTheme.TotallyTransparent" />

        <!-- Debug 专用：比较真实弹窗的动画输入与显示完成后的配色。 -->
        <activity android:name=".views.particledismiss.ParticleSwipeShadowProbeActivity"
            android:exported="true" android:excludeFromRecents="true"
            android:theme="@style/EverythingDoneTheme.Things" />

        <activity
            android:name="com.ywwynm.everythingdone.views.particledismiss.ParticleAppearanceProbeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/EverythingDoneTheme.Things" />

        <!-- 调试包专用：同一生产渲染器的固定输入、像素与 GPU 状态验证。 -->
        <receiver
            android:name="com.ywwynm.everythingdone.views.particledismiss.ParticleMicroflakeProbeReceiver"
            android:exported="true" />

        <!-- Debug 专用着色器变体编译矩阵入口。EMUI 拦截发给清单接收器的广播，Activity 不受限。 -->
        <activity
            android:name="com.ywwynm.everythingdone.views.particledismiss.ParticleShaderMatrixActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/EverythingDoneTheme.TotallyTransparent" />

        <!-- Debug 专用离屏基准入口：adb am broadcast 触发，锁屏可用。 -->
        <receiver
            android:name="com.ywwynm.everythingdone.views.recording.fablesol.FableSolBenchmarkReceiver"
            android:exported="true" />

        <!-- Debug 专用双模型算子/延迟探针：模型由 adb 放入 app external files，不打包进 APK。 -->
        <receiver
            android:name="com.ywwynm.everythingdone.spatial.SpatialDepthBenchmarkReceiver"
            android:exported="true" />

        <!-- Debug 专用补全模型探针：模型尚未上架 catalog 时验证算子覆盖、耗时与峰值内存。 -->
        <receiver
            android:name="com.ywwynm.everythingdone.spatial.SpatialInpaintingBenchmarkReceiver"
            android:exported="true" />

        <!-- Debug 专用产品纵向链路入口：打开模型设置或指定外部测试图，不读写用户记事。 -->
        <receiver
            android:name="com.ywwynm.everythingdone.spatial.SpatialPhotoDebugLauncherReceiver"
            android:exported="true" />

        <!-- Debug 专用完整空间派生探针：锁屏时验证端侧模型、补景和持久化链。 -->
        <receiver
            android:name="com.ywwynm.everythingdone.spatial.SpatialVNextGenerationProbeReceiver"
            android:exported="true" />

        <!-- Debug 专用 QNN EP 探针：自带 QNN 版 ORT，必须在干净进程里跑（先 force-stop）。 -->
        <receiver
            android:name="com.ywwynm.everythingdone.spatial.SpatialQnnProbeReceiver"
            android:exported="true" />

        <activity
            android:name="com.ywwynm.everythingdone.spatial.SpatialPhotoDebugLauncherActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/EverythingDoneTheme.TotallyTransparent" />
    </application>

</manifest>
