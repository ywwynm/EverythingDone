#version 310 es
precision highp float;
precision highp int;
layout(local_size_x=16,local_size_y=16) in;
layout(std430,binding=0) readonly buffer A { vec4 velocity[]; };
layout(std430,binding=2) writeonly buffer B { float next_pressure[]; };
layout(std430,binding=7) buffer Work {
    // 间接分发参数；必须是**标量**成员：Maleoon 910 上对向量分量做原子操作
    // 不按下标寻址（见 peel-splat.comp 的同一条）。
    uint group_count,group_y,group_z,group_pad;
    ivec4 region;
    ivec4 previous;
    int box_x0,box_y0,box_x1,box_y1;
    ivec2 tiles[];
};
uniform ivec2 grid_shape;
uniform int pass;
// 与 pressure-tiles.comp 相同，只是一个工作组覆盖 32×32 格（每线程四格），
// 与 pressure-batched-large.comp 的输出 tile 尺寸一致。
shared uint occupied_tile;
void main() {
    uint lane=gl_LocalInvocationIndex;
    if(pass==0) { if(lane==0u){group_count=0u;group_y=1u;group_z=1u;group_pad=0u;} return; }
    if(lane==0u)occupied_tile=0u;
    barrier();
    bool mine=false;
    for(int dy=0;dy<2;dy++)for(int dx=0;dx<2;dx++) {
        ivec2 q=ivec2(gl_WorkGroupID.xy)*32+ivec2(gl_LocalInvocationID.xy)+ivec2(dx,dy)*16;
        if(any(greaterThanEqual(q,grid_shape)))continue;
        next_pressure[q.y*grid_shape.x+q.x]=0.;
        if(velocity[q.y*grid_shape.x+q.x].z>.025)mine=true;
    }
    if(pass==2)return;
    if(mine)atomicOr(occupied_tile,1u);
    barrier();
    if(lane==0u && occupied_tile!=0u) {
        uint slot=atomicAdd(group_count,1u);
        tiles[slot]=ivec2(gl_WorkGroupID.xy);
    }
}
