#version 310 es
precision highp float;
precision highp int;
layout(local_size_x=16,local_size_y=16) in;
layout(std430,binding=0) readonly buffer A { vec4 velocity[]; };
layout(std430,binding=2) writeonly buffer B { float next_pressure[]; };
layout(std430,binding=7) buffer Work {
    uvec4 workgroups;
    ivec4 region;
    ivec4 previous;
    int box_x0,box_y0,box_x1,box_y1;
    ivec2 tiles[];
};
uniform ivec2 grid_shape;
uniform int pass;
shared uint occupied_tile;
void main() {
    uint lane=gl_LocalInvocationIndex;
    if(pass==0) { if(lane==0u)workgroups=uvec4(0,1,1,0); return; }
    ivec2 q=ivec2(gl_GlobalInvocationID.xy);
#ifdef ACTIVE_REGION
    // C10：活动区域之外三个缓冲恒为零，整组直接退出。区域按 16 格对齐，所以这个判定在
    // 组内是一致的——`barrier()` 要求一致的控制流，逐线程早退会是未定义行为。
    if(any(lessThan(q,region.xy))||any(greaterThan(q,region.zw)))return;
#endif
    bool valid=all(lessThan(q,grid_shape));
    if(valid)next_pressure[q.y*grid_shape.x+q.x]=0.;
    if(pass==2)return;
    if(lane==0u)occupied_tile=0u;
    barrier();
    if(valid && velocity[q.y*grid_shape.x+q.x].z>.025)atomicOr(occupied_tile,1u);
    barrier();
    if(lane==0u && occupied_tile!=0u) {
        uint slot=atomicAdd(workgroups.x,1u);
        tiles[slot]=ivec2(gl_WorkGroupID.xy);
    }
}
