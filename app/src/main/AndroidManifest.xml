        android:required="false"/>

    <!-- 应用内碰一碰（二期）：NFC 握手 + Wi-Fi Direct 传输。都不是必需的硬件，
         不支持的设备上两个入口直接隐藏（docs/features/thing-transfer/decisions.md）。 -->
    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false"/>
    <uses-feature
        android:name="android.hardware.nfc.hce"
        android:required="false"/>
    <uses-feature
        android:name="android.hardware.wifi.direct"
        android:required="false"/>

