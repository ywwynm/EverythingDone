<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="EverythingDoneTheme.Settings" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorAccent">@color/blue_deep</item>
        <item name="android:textColorPrimary">@color/app_chrome_on_surface_primary</item>
        <item name="android:textColorSecondary">@color/app_chrome_on_surface_secondary</item>
        <item name="colorControlNormal">@color/app_chrome_on_surface_secondary</item>
        <item name="colorControlHighlight">@color/app_chrome_ripple</item>
        <item name="android:colorBackground">@color/app_chrome_surface</item>
        <item name="swirl_ridgeColor">@color/blue_deep</item>
        <item name="swirl_errorColor">@color/error</item>
        <item name="android:statusBarColor">@color/bg_statusbar_lollipop</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="EverythingDoneTheme.Dialog" parent="Theme.AppCompat.DayNight.Dialog">
        <item name="windowNoTitle">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowMinWidthMajor">0dp</item>
        <item name="android:windowMinWidthMinor">0dp</item>
        <item name="windowMinWidthMajor">0dp</item>
        <item name="windowMinWidthMinor">0dp</item>
        <item name="android:windowBackground">@color/app_chrome_surface_elevated</item>
        <item name="colorBackgroundFloating">@color/app_chrome_surface_elevated</item>
        <item name="android:colorBackgroundFloating">@color/app_chrome_surface_elevated</item>
        <item name="colorAccent">@color/blue_deep</item>
        <item name="android:textColorPrimary">@color/app_chrome_on_surface_primary</item>
        <item name="android:textColorSecondary">@color/app_chrome_on_surface_secondary</item>
        <item name="colorControlNormal">@color/app_chrome_on_surface_secondary</item>
        <item name="colorControlHighlight">@color/app_chrome_ripple</item>
        <item name="android:colorBackground">@color/app_chrome_surface_elevated</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="EverythingDoneTheme.ThingWidgetConfiguration"
           parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:textColorPrimary">@color/app_chrome_on_surface_primary</item>
        <item name="android:textColorSecondary">@color/app_chrome_on_surface_secondary</item>
        <item name="colorControlNormal">@color/app_chrome_on_surface_secondary</item>
        <item name="colorControlHighlight">@color/app_chrome_ripple</item>
        <item name="android:colorBackground">@color/app_chrome_surface</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

</resources>
