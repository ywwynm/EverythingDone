<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingBottom="8dp">
    <TextView android:id="@+id/tap_update_settings_title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/app_chrome_dialog_title_margin_horizontal"
        android:layout_marginEnd="@dimen/app_chrome_dialog_title_margin_horizontal"
        android:layout_marginTop="@dimen/app_chrome_dialog_title_margin_top"
        android:text="@string/tap_update_settings_title"
        android:textSize="@dimen/app_chrome_dialog_title_text_size" android:textStyle="bold"
        android:textColor="@color/app_chrome_on_surface_primary" />
    <TextView android:id="@+id/tap_update_settings_description"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="20dp" android:layout_marginEnd="20dp"
        android:layout_marginTop="16dp" android:layout_marginBottom="16dp"
        android:text="@string/tap_update_settings_description" android:textSize="16sp"
        android:textColor="@color/app_chrome_on_surface_secondary" />
    <TextView android:id="@+id/tap_update_keep"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="56dp" android:gravity="end|center_vertical"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:paddingTop="16dp" android:paddingBottom="16dp"
        android:maxLines="1" android:ellipsize="end"
        android:text="@string/tap_update_keep_settings"
        android:textSize="16sp" android:textColor="@color/app_chrome_on_surface_primary" />
    <TextView android:id="@+id/tap_update_replace"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="56dp" android:gravity="end|center_vertical"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:paddingTop="16dp" android:paddingBottom="16dp"
        android:maxLines="1" android:ellipsize="end"
        android:text="@string/tap_update_use_received_settings"
        android:textSize="16sp" android:textColor="@color/app_chrome_on_surface_primary" />
</LinearLayout>
