<?xml version="1.0" encoding="utf-8"?>
<!--
  设置页预览用的示例对话框：圆角、内边距、标题与「取消 / 确定」一行按钮全部沿用
  fragment_alert 的取值与 app_chrome_dialog_* 尺寸，底色取常规的 surface 色，跟随深浅色模式。
  它是页内的一块视图，不是真的对话框窗口——粒子走的是 ParticlePanelAnimator 那条页内内容
  路径（与详情页里的面板同一条）。
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cv_particle_tuning_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:clipToOutline="true"
    app:cardBackgroundColor="@color/app_chrome_surface_elevated"
    app:cardCornerRadius="@dimen/app_chrome_dialog_popup_corner_radius"
    app:cardElevation="@dimen/particle_tuning_dialog_elevation"
    app:cardPreventCornerOverlap="false">

    <LinearLayout
        android:id="@+id/ll_particle_tuning_dialog_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_particle_tuning_dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/app_chrome_dialog_title_margin_horizontal"
            android:layout_marginTop="@dimen/app_chrome_dialog_title_margin_top"
            android:layout_marginRight="@dimen/app_chrome_dialog_title_margin_horizontal"
            android:textAllCaps="true"
            android:textSize="@dimen/app_chrome_dialog_title_text_size"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tv_particle_tuning_dialog_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="20dp"
            android:textColor="@color/app_chrome_on_surface_secondary"
            android:textSize="16sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/app_chrome_dialog_action_row_margin_horizontal"
            android:layout_marginTop="@dimen/app_chrome_dialog_action_row_margin_top"
            android:layout_marginRight="@dimen/app_chrome_dialog_action_row_margin_horizontal"
            android:layout_marginBottom="@dimen/app_chrome_dialog_action_row_margin_bottom"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_particle_tuning_dialog_cancel"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/app_chrome_dialog_action_button_height"
                android:paddingLeft="@dimen/app_chrome_dialog_action_button_padding_horizontal"
                android:paddingTop="@dimen/app_chrome_dialog_action_button_padding_vertical"
                android:paddingRight="@dimen/app_chrome_dialog_action_button_padding_horizontal"
                android:paddingBottom="@dimen/app_chrome_dialog_action_button_padding_vertical"
                android:textAllCaps="true"
                android:textColor="@color/app_chrome_dialog_cancel"
                android:textSize="@dimen/app_chrome_dialog_action_text_size"/>

            <TextView
                android:id="@+id/tv_particle_tuning_dialog_confirm"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/app_chrome_dialog_action_button_height"
                android:layout_marginEnd="@dimen/app_chrome_dialog_action_button_margin_end"
                android:layout_marginRight="@dimen/app_chrome_dialog_action_button_margin_end"
                android:paddingLeft="@dimen/app_chrome_dialog_action_button_padding_horizontal"
                android:paddingTop="@dimen/app_chrome_dialog_action_button_padding_vertical"
                android:paddingRight="@dimen/app_chrome_dialog_action_button_padding_horizontal"
                android:paddingBottom="@dimen/app_chrome_dialog_action_button_padding_vertical"
                android:textAllCaps="true"
                android:textSize="@dimen/app_chrome_dialog_action_text_size"
                android:textStyle="bold"/>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
