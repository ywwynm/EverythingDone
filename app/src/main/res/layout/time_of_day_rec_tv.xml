<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="40dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/tv_new_reminder_as_bt_rec_day"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="-4dp"
        android:layout_marginLeft="-4dp"
        android:paddingStart="4dp"
        android:paddingLeft="4dp"
        android:paddingEnd="10dp"
        android:paddingRight="10dp"
        android:gravity="center"
        android:drawableStart="@drawable/act_new_time_rec"
        android:drawableLeft="@drawable/act_new_time_rec"
        android:drawablePadding="12dp"
        android:textColor="@color/date_time_rec_new_foreground"
        android:textSize="16sp"
        android:text="@string/new_reminder_time_rec"
        android:background="@drawable/selectable_item_background"/>

</LinearLayout>
