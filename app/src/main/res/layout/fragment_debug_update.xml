<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_title_debug_update"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="20dp"
        android:text="@string/debug_update_available_title"
        android:textAllCaps="true"
        android:textSize="20sp"
        android:textStyle="bold"/>

    <View
        android:id="@+id/view_separator_1"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/app_chrome_divider"
        android:visibility="gone"/>

    <ScrollView
        android:id="@+id/sv_debug_update"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:id="@+id/ll_debug_update_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp">

            <TextView
                android:id="@+id/tv_debug_update_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/app_chrome_on_surface_primary"
                android:textSize="15sp"/>

            <TextView
                android:id="@+id/tv_debug_update_build"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/app_chrome_on_surface_primary"
                android:textSize="15sp"/>

            <TextView
                android:id="@+id/tv_debug_update_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/app_chrome_on_surface_primary"
                android:textSize="15sp"/>

            <TextView
                android:id="@+id/tv_debug_update_published"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/app_chrome_on_surface_primary"
                android:textSize="15sp"/>

            <TextView
                android:id="@+id/tv_debug_update_notes_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/debug_update_release_notes_label"
                android:textColor="@color/app_chrome_on_surface_secondary"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/tv_debug_update_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/app_chrome_on_surface_primary"
                android:textSize="14sp"/>

        </LinearLayout>

    </ScrollView>

    <View
        android:id="@+id/view_separator_2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/app_chrome_divider"
        android:visibility="gone"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="8dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_cancel_as_bt_debug_update"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/selectable_item_background"
            android:paddingLeft="12dp"
            android:paddingTop="8dp"
            android:paddingRight="12dp"
            android:paddingBottom="8dp"
            android:text="@string/cancel"
            android:textAllCaps="true"
            android:textColor="@color/app_chrome_on_surface_hint"/>

        <TextView
            android:id="@+id/tv_download_as_bt_debug_update"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:layout_marginRight="4dp"
            android:background="@drawable/selectable_item_background"
            android:paddingLeft="12dp"
            android:paddingTop="8dp"
            android:paddingRight="12dp"
            android:paddingBottom="8dp"
            android:text="@string/debug_update_download_install"
            android:textAllCaps="true"
            android:textStyle="bold"/>

    </LinearLayout>

</LinearLayout>
