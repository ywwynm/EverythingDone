<?xml version="1.0" encoding="utf-8"?>
<com.ywwynm.everythingdone.views.ScrollAwareColumn
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/thing_card_appearance_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true"
    android:layout_gravity="bottom|center_horizontal"
    android:layout_marginLeft="@dimen/thing_card_outer_spacing"
    android:layout_marginRight="@dimen/thing_card_outer_spacing"
    android:layout_marginBottom="@dimen/thing_card_outer_spacing"
    android:background="@drawable/bg_app_chrome_surface_elevated_rounded"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:elevation="12dp"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingLeft="@dimen/app_chrome_dialog_title_margin_horizontal"
    android:paddingTop="@dimen/app_chrome_dialog_title_margin_top"
    android:paddingRight="@dimen/app_chrome_dialog_title_margin_horizontal"
    android:paddingBottom="@dimen/app_chrome_dialog_action_row_margin_bottom"
    android:visibility="gone"
    tools:visibility="visible">

    <LinearLayout
        android:id="@+id/ll_thing_card_appearance_title_row"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_thing_card_appearance_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/thing_card_appearance_panel_title"
            android:textAllCaps="true"
            android:textColor="@color/app_chrome_on_surface_primary"
            android:textSize="@dimen/app_chrome_dialog_title_text_size" />

        <EditText
            android:id="@+id/et_folder_card_appearance_name"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="@dimen/app_chrome_dialog_action_button_margin_end"
            android:layout_marginRight="@dimen/app_chrome_dialog_action_button_margin_end"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:ellipsize="end"
            android:hint="@string/folder_card_appearance_name_hint"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:paddingLeft="0dp"
            android:paddingRight="0dp"
            android:singleLine="true"
            android:textColor="@color/app_chrome_on_surface_primary"
            android:textColorHint="@color/app_chrome_on_surface_hint"
            android:textSize="18sp"
            android:visibility="gone"
            tools:visibility="gone" />

        <ImageView
            android:id="@+id/bt_thing_card_appearance_change_color"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="-6dp"
            android:layout_marginRight="-6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/act_adjust_color"
            android:focusable="true"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/act_change_color" />

    </LinearLayout>

    <!-- 颜色页标题行：返回箭头 + “调整颜色”，默认隐藏，进入颜色页时显示 -->
    <LinearLayout
        android:id="@+id/ll_tca_color_page_title"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="gone">

        <ImageView
            android:id="@+id/bt_tca_color_page_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="-8dp"
            android:layout_marginLeft="-8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/color_editor_back"
            android:focusable="true"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/tv_tca_color_page_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginLeft="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/act_adjust_color"
            android:textAllCaps="true"
            android:textColor="@color/app_chrome_on_surface_primary"
            android:textSize="@dimen/app_chrome_dialog_title_text_size" />

    </LinearLayout>

    <!-- 颜色页顶部分割线：仅颜色页可见，按滚动情况显隐 -->
    <View
        android:id="@+id/sep_tca_top"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="@dimen/tbe_divider_bleed_margin"
        android:layout_marginRight="@dimen/tbe_divider_bleed_margin"
        android:layout_marginTop="12dp"
        android:background="@color/app_chrome_divider"
        android:visibility="gone"
        tools:visibility="gone" />

    <!-- 外观设置主体：进入颜色页时整体隐藏 -->
    <LinearLayout
        android:id="@+id/ll_tca_appearance_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <LinearLayout
        android:id="@+id/ll_thing_card_appearance_source"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_thing_card_appearance_source_label"
            android:layout_width="76dp"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:text="@string/thing_card_appearance_cover_media"
            android:textColor="@color/app_chrome_on_surface_hint"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_thing_card_appearance_source"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:drawableEnd="@drawable/ic_dropdown"
            android:drawablePadding="8dp"
            android:drawableRight="@drawable/ic_dropdown"
            android:ellipsize="middle"
            android:focusable="true"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:textColor="@color/app_chrome_on_surface_secondary"
            android:textSize="14sp"
            tools:text="Auto select · cover.jpg" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_thing_card_appearance_video_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:visibility="gone"
        tools:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:gravity="center_vertical"
            android:text="@string/thing_card_appearance_video_frame"
            android:textColor="@color/app_chrome_on_surface_hint"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/iv_thing_card_appearance_video_frame_preview"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="4dp"
            android:background="@color/black_10p"
            android:contentDescription="@string/thing_card_appearance_video_frame_preview"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/bt_thing_card_appearance_video_frame_previous"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:contentDescription="@string/thing_card_appearance_video_frame_previous"
                android:focusable="true"
                android:gravity="center"
                android:text="-"
                android:textSize="18sp" />

        <SeekBar
            android:id="@+id/seek_thing_card_appearance_video_frame"
                android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1" />

            <TextView
                android:id="@+id/bt_thing_card_appearance_video_frame_next"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:contentDescription="@string/thing_card_appearance_video_frame_next"
                android:focusable="true"
                android:gravity="center"
                android:text="+"
                android:textSize="18sp" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_thing_card_appearance_span_controls"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_thing_card_appearance_card_width"
            android:layout_width="76dp"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:text="@string/thing_card_appearance_card_width"
            android:textColor="@color/app_chrome_on_surface_hint"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/bt_thing_card_appearance_span_normal"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/thing_card_appearance_span_normal"
            android:textColor="@color/app_chrome_on_surface_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/bt_thing_card_appearance_span_full"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/thing_card_appearance_span_full"
            android:textColor="@color/app_chrome_on_surface_secondary"
            android:textSize="14sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_thing_card_appearance_media_position"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:text="@string/thing_card_appearance_media_position"
        android:textColor="@color/app_chrome_on_surface_hint"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/ll_thing_card_appearance_placement_controls"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_folder_card_appearance_size_label"
            android:layout_width="76dp"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:text="@string/folder_card_appearance_display_mode"
            android:textColor="@color/app_chrome_on_surface_hint"
            android:textSize="13sp"
            android:visibility="gone"
            tools:visibility="gone" />

        <TextView
            android:id="@+id/bt_thing_card_appearance_placement_top"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/thing_card_appearance_placement_top"
            android:textColor="@color/app_chrome_on_surface_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/bt_thing_card_appearance_placement_bottom"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/thing_card_appearance_placement_bottom"
            android:textColor="@color/app_chrome_on_surface_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/bt_thing_card_appearance_placement_left"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/thing_card_appearance_placement_left"
            android:textColor="@color/app_chrome_on_surface_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/bt_thing_card_appearance_placement_right"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/thing_card_appearance_placement_right"
            android:textColor="@color/app_chrome_on_surface_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/bt_thing_card_appearance_placement_background"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/thing_card_appearance_mode_background"
            android:textColor="@color/app_chrome_on_surface_secondary"
            android:textSize="13sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_thing_card_appearance_thumbnail_ratio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="6dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:gravity="center_vertical"
            android:text="@string/thing_card_appearance_thumbnail_shape"
            android:textColor="@color/app_chrome_on_surface_hint"
            android:textSize="13sp" />

        <com.ywwynm.everythingdone.views.RatioSlider
            android:id="@+id/v_thing_card_appearance_ratio_slider"
            android:layout_width="match_parent"
            android:layout_height="52dp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_thing_card_appearance_side_width"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dp">

        <TextView
            android:id="@+id/tv_thing_card_appearance_side_width"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:gravity="center_vertical"
            android:textColor="@color/app_chrome_on_surface_hint"
            android:textSize="13sp"
            tools:text="Cover image width · 42%" />

        <SeekBar
            android:id="@+id/seek_thing_card_appearance_side_width"
            android:layout_width="match_parent"
            android:layout_height="40dp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_thing_card_appearance_background_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:text="@string/thing_card_appearance_background_mask"
                android:textColor="@color/app_chrome_on_surface_hint"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seek_thing_card_appearance_background_mask"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_marginLeft="8dp"
                android:layout_weight="1" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:text="@string/thing_card_appearance_background_height"
                android:textColor="@color/app_chrome_on_surface_hint"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seek_thing_card_appearance_background_height"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_marginLeft="8dp"
                android:layout_weight="1" />

        </LinearLayout>

    </LinearLayout>

    </LinearLayout>
    <!-- /外观设置主体 -->

    <!-- 颜色页：纯色/渐变编辑器（可滚动），默认隐藏，进入颜色页时显示 -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_tca_color_page"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:scrollbars="none"
        android:visibility="gone"
        tools:visibility="gone">

        <com.ywwynm.everythingdone.views.ThingBackgroundEditor
            android:id="@+id/tbe_thing_card_appearance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </androidx.core.widget.NestedScrollView>

    <!-- 颜色页底部分割线：仅颜色页可见，按滚动情况显隐 -->
    <View
        android:id="@+id/sep_tca_bottom"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="@dimen/tbe_divider_bleed_margin"
        android:layout_marginRight="@dimen/tbe_divider_bleed_margin"
        android:background="@color/app_chrome_divider"
        android:visibility="gone"
        tools:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/app_chrome_dialog_divided_action_row_margin_top"
        android:layout_marginEnd="@dimen/app_chrome_dialog_action_row_overflow_margin"
        android:layout_marginRight="@dimen/app_chrome_dialog_action_row_overflow_margin"
        android:gravity="center_vertical|end"
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false">

        <TextView
            android:id="@+id/bt_thing_card_appearance_precise_crop"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/app_chrome_dialog_action_button_height"
            android:layout_marginLeft="@dimen/app_chrome_dialog_leading_action_margin_start"
            android:layout_marginStart="@dimen/app_chrome_dialog_leading_action_margin_start"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingLeft="@dimen/app_chrome_dialog_action_button_padding_horizontal"
            android:paddingTop="@dimen/app_chrome_dialog_action_button_padding_vertical"
            android:paddingRight="@dimen/app_chrome_dialog_action_button_padding_horizontal"
            android:paddingBottom="@dimen/app_chrome_dialog_action_button_padding_vertical"
            android:text="@string/thing_card_appearance_precise_crop"
            android:textSize="@dimen/app_chrome_dialog_action_text_size" />

        <Space
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/bt_cancel_thing_card_appearance"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/app_chrome_dialog_action_button_height"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingLeft="@dimen/app_chrome_dialog_action_button_padding_horizontal"
            android:paddingTop="@dimen/app_chrome_dialog_action_button_padding_vertical"
            android:paddingRight="@dimen/app_chrome_dialog_action_button_padding_horizontal"
            android:paddingBottom="@dimen/app_chrome_dialog_action_button_padding_vertical"
            android:text="@string/cancel"
            android:textAllCaps="true"
            android:textColor="@color/app_chrome_dialog_cancel"
            android:textSize="@dimen/app_chrome_dialog_action_text_size" />

        <TextView
            android:id="@+id/bt_confirm_thing_card_appearance"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/app_chrome_dialog_action_button_height"
            android:layout_marginEnd="@dimen/app_chrome_dialog_action_button_margin_end"
            android:layout_marginRight="@dimen/app_chrome_dialog_action_button_margin_end"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingLeft="@dimen/app_chrome_dialog_action_button_padding_horizontal"
            android:paddingTop="@dimen/app_chrome_dialog_action_button_padding_vertical"
            android:paddingRight="@dimen/app_chrome_dialog_action_button_padding_horizontal"
            android:paddingBottom="@dimen/app_chrome_dialog_action_button_padding_vertical"
            android:text="@string/confirm"
            android:textAllCaps="true"
            android:textSize="@dimen/app_chrome_dialog_action_text_size" />

    </LinearLayout>

</com.ywwynm.everythingdone.views.ScrollAwareColumn>
