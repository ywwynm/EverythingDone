<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_widget_folder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_app_widget_card_clip"
    android:clipToOutline="true"
    android:foreground="@drawable/selectable_item_background_light">

    <ImageView
        android:id="@+id/iv_widget_folder_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:importantForAccessibility="no"
        android:contentDescription="@null"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/iv_widget_folder_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_thing_folder"
            android:contentDescription="@string/thing_folder"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_widget_folder_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="@color/white_86p"
                android:textStyle="bold"
                android:textSize="15sp"/>

            <TextView
                android:id="@+id/tv_widget_folder_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="@color/white_76p"
                android:textSize="12sp"/>

        </LinearLayout>

        <ImageView
            android:id="@+id/iv_widget_folder_lock"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_locked_big"
            android:contentDescription="@string/private_thing_folder"
            android:visibility="gone"/>

    </LinearLayout>

</FrameLayout>
