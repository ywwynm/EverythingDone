<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_title_color_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/app_chrome_dialog_title_margin_horizontal"
        android:layout_marginTop="@dimen/app_chrome_dialog_title_margin_top"
        android:layout_marginRight="@dimen/app_chrome_dialog_title_margin_horizontal"
        android:text="@string/color_info_title"
        android:textAllCaps="true"
        android:textSize="@dimen/app_chrome_dialog_title_text_size"
        android:textStyle="bold"/>

    <View
        android:id="@+id/v_color_info_preview"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="20dp"/>

    <View
        android:id="@+id/view_separator_1"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/app_chrome_divider"
        android:visibility="gone"/>

    <ScrollView
        android:id="@+id/sv_color_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:id="@+id/ll_color_info_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"/>

    </ScrollView>

    <View
        android:id="@+id/view_separator_2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/app_chrome_divider"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tv_confirm_as_bt_color_info"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/app_chrome_dialog_action_button_height"
        android:layout_marginTop="@dimen/app_chrome_dialog_divided_action_row_margin_top"
        android:layout_marginBottom="@dimen/app_chrome_dialog_action_row_margin_bottom"
        android:layout_marginEnd="@dimen/app_chrome_dialog_action_single_button_margin_end"
        android:layout_marginRight="@dimen/app_chrome_dialog_action_single_button_margin_end"
        android:layout_gravity="end"
        android:paddingLeft="@dimen/app_chrome_dialog_action_button_padding_horizontal"
        android:paddingTop="@dimen/app_chrome_dialog_action_button_padding_vertical"
        android:paddingRight="@dimen/app_chrome_dialog_action_button_padding_horizontal"
        android:paddingBottom="@dimen/app_chrome_dialog_action_button_padding_vertical"
        android:background="@drawable/selectable_item_background"
        android:text="@string/act_get_it"
        android:textAllCaps="true"
        android:textStyle="bold"
        android:textSize="@dimen/app_chrome_dialog_action_text_size"/>

</LinearLayout>
