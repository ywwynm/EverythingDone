<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 8: dialog content for the gradient-direction picker. Title at top
     and an empty 2×4 GridLayout container — the 8 direction FAB cells are
     inflated programmatically in GradientOrientationDialogFragment using the
     same FAB+overlay pattern as ColorPicker's random-gradient FAB
     (color_picker_fab.xml). That gives us Material's native circular
     ripple AND a correctly-sized 24dp checkmark for the picked cell. -->
<!-- Title margins and the lack of outer padding match fragment_add_attachment.xml
     through the shared App Chrome dialog title dimensions so this dialog looks
     consistent with the other title+items dialogs. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_title_gradient_orientation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/app_chrome_dialog_title_margin_horizontal"
        android:layout_marginTop="@dimen/app_chrome_dialog_title_margin_top"
        android:layout_marginRight="@dimen/app_chrome_dialog_title_margin_horizontal"
        android:textSize="@dimen/app_chrome_dialog_title_text_size"
        android:textStyle="bold"
        android:text="@string/gradient_orientation_title"/>

    <!-- Title.marginLeft=20dp. With grid layout_marginLeft=12dp + cell margin=8dp
         (set in Java), the leftmost FAB lands at 12+8=20dp from the dialog edge,
         aligning exactly with the title's left edge. layout_gravity is start
         (default) so the grid hugs the left side; the LinearLayout's
         wrap_content width then matches the grid's natural width and the
         dialog window sizes to fit. -->
    <GridLayout
        android:id="@+id/gl_gradient_orientations"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="16dp"
        android:rowCount="2"
        android:columnCount="4"/>

</LinearLayout>
