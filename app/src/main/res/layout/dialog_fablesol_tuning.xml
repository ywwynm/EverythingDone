<?xml version="1.0" encoding="utf-8"?>
<!-- FableSol 调参 Dialog：预览贴顶满宽（无标题、无侧边留白，底部两角由渲染端
     切成直角与内容衔接），右上角悬浮暂停/换色按钮；参数区上下滚动。窗口高度由
     FableSolTuningDialogFragment.onStart 按屏幕高度收敛，ScrollView 用 weight 吸收。 -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="240dp">

        <!-- 与录音界面同一渲染宿主：GLES 九层水体 + HDR，实时录音驱动。逻辑空间
             420dp 高、视口中心对齐，另加向上取景平移让第 0 层波谷不被下边缘遮挡。 -->
        <com.ywwynm.everythingdone.views.recording.fablesol.WaveVisualizerFableSolHost
            android:id="@+id/fablesol_tuning_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginRight="8dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_fablesol_tuning_pause"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:layout_marginRight="8dp"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/act_fablesol_pause"
                android:tint="@color/app_chrome_on_surface_secondary"
                android:contentDescription="@string/cd_fablesol_tuning_pause"
                android:clickable="true"
                android:focusable="true"/>

            <ImageView
                android:id="@+id/iv_fablesol_tuning_palette"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/act_fablesol_palette"
                android:tint="@color/app_chrome_on_surface_secondary"
                android:contentDescription="@string/cd_fablesol_tuning_switch_color"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>

    </FrameLayout>

    <View
        android:id="@+id/view_fablesol_tuning_scroll_indicator"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/app_chrome_divider"
        android:visibility="invisible"/>

    <!-- overScroll 拉伸效果（Android 12+ 的 RenderEffect stretch）会给整块列表内容
         叠一层每帧变化的 GPU 特效，实测拖垮上方 GL 预览的帧率，禁用之；到边提示
         由上下两条滚动指示分隔线承担。 -->
    <ScrollView
        android:id="@+id/sv_fablesol_tuning_params"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:clipToPadding="false"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/ll_fablesol_tuning_params"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HDR 强度滑杆行（D204）：1.0=关闭、默认=上限 9.6。结构与
                 FableSolTuningDialogFragment.makeSliderRow 的程序化参数行一致。 -->
            <LinearLayout
                android:id="@+id/ll_fablesol_tuning_hdr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="20dp"
                android:paddingTop="9dp"
                android:paddingRight="20dp"
                android:paddingBottom="5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_fablesol_tuning_hdr"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/fablesol_tuning_hdr"
                        android:textSize="13sp"/>

                    <TextView
                        android:id="@+id/tv_fablesol_tuning_hdr_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.6"
                        android:textSize="12sp"/>

                </LinearLayout>

                <SeekBar
                    android:id="@+id/sb_fablesol_tuning_hdr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <View
        android:id="@+id/view_fablesol_tuning_bottom_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/app_chrome_divider"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/app_chrome_dialog_action_row_margin_horizontal"
        android:layout_marginTop="@dimen/app_chrome_dialog_divided_action_row_margin_top"
        android:layout_marginRight="@dimen/app_chrome_dialog_action_row_margin_horizontal"
        android:layout_marginBottom="@dimen/app_chrome_dialog_action_row_margin_bottom"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_fablesol_tuning_reset_as_bt"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/app_chrome_dialog_action_button_height"
            android:paddingLeft="@dimen/app_chrome_dialog_action_button_padding_horizontal"
            android:paddingTop="@dimen/app_chrome_dialog_action_button_padding_vertical"
            android:paddingRight="@dimen/app_chrome_dialog_action_button_padding_horizontal"
            android:paddingBottom="@dimen/app_chrome_dialog_action_button_padding_vertical"
            android:background="@drawable/selectable_item_background"
            android:textColor="@color/app_chrome_dialog_cancel"
            android:textAllCaps="true"
            android:text="@string/fablesol_tuning_reset"
            android:textSize="@dimen/app_chrome_dialog_action_text_size"/>

        <TextView
            android:id="@+id/tv_fablesol_tuning_done_as_bt"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/app_chrome_dialog_action_button_height"
            android:layout_marginEnd="@dimen/app_chrome_dialog_action_button_margin_end"
            android:layout_marginRight="@dimen/app_chrome_dialog_action_button_margin_end"
            android:paddingLeft="@dimen/app_chrome_dialog_action_button_padding_horizontal"
            android:paddingTop="@dimen/app_chrome_dialog_action_button_padding_vertical"
            android:paddingRight="@dimen/app_chrome_dialog_action_button_padding_horizontal"
            android:paddingBottom="@dimen/app_chrome_dialog_action_button_padding_vertical"
            android:textStyle="bold"
            android:text="@string/confirm"
            android:textAllCaps="true"
            android:background="@drawable/selectable_item_background"
            android:textSize="@dimen/app_chrome_dialog_action_text_size"/>

    </LinearLayout>

</LinearLayout>
