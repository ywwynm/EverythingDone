<?xml version="1.0" encoding="utf-8"?>
<merge
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.ywwynm.everythingdone.activities.ImageViewerActivity">

    <com.ywwynm.everythingdone.views.HackyViewPager
        android:id="@+id/vp_image_viewer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <com.ywwynm.everythingdone.spatial.SpatialPhotoView
        android:id="@+id/spatial_photo_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/cd_spatial_photo_view"
        android:visibility="gone"/>

    <LinearLayout
        android:id="@+id/ll_spatial_strength"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="22dp"
        android:background="@drawable/bg_spatial_strength"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/iv_spatial_strength_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_spatial_effect"
            android:contentDescription="@null"
            android:importantForAccessibility="no"/>

        <SeekBar
            android:id="@+id/sb_spatial_strength"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:max="100"
            android:contentDescription="@string/spatial_effect_strength"/>

        <Button
            android:id="@+id/btn_spatial_render_mode"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:minWidth="72dp"
            android:minHeight="36dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/spatial_render_mode_p1_short"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"/>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/fl_spatial_generation"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <ProgressBar
                android:id="@+id/pb_spatial_generation"
                android:layout_width="40dp"
                android:layout_height="40dp"/>

            <TextView
                android:id="@+id/tv_spatial_generation_stage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/spatial_generation_preparing"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"/>

            <Button
                android:id="@+id/btn_cancel_spatial_generation"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/cancel"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"/>

        </LinearLayout>

    </FrameLayout>

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/actionbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#00000000"
        android:theme="@style/EverythingDoneTheme.ImageViewer.Actionbar"
        app:contentInsetStart="72dp"/>

    <!-- 顶部徽标横条：HDR(左) 与 实况(右) 放同一容器、各自 center_vertical，
         与各自高度无关地在 y 方向居中对齐。marginTop 与顶部 inset 统一加到容器。 -->
    <FrameLayout
        android:id="@+id/fl_top_badges"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="64dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <com.ywwynm.everythingdone.views.HdrBadgeView
            android:id="@+id/tv_hdr_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="@string/hdr_badge_text"
            android:visibility="gone"/>

        <LinearLayout
            android:id="@+id/ll_live_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_live_badge"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:contentDescription="@string/cd_motion_photo"
            android:visibility="gone">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_live_badge"
                android:importantForAccessibility="no"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="2dp"
                android:text="@string/motion_photo_live_badge"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:includeFontPadding="false"/>

        </LinearLayout>

    </FrameLayout>

</merge>
