<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <com.github.chrisbanes.photoview.PhotoView
        android:id="@+id/iv_image_attachment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/cd_image_attachment"
        android:background="#000000"/>

    <!-- Motion Photo 按住播放层：默认 alpha=0（不可见），按住时播放内嵌视频并置 alpha=1 盖住静图。 -->
    <TextureView
        android:id="@+id/tv_motion_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"/>

    <ImageView
        android:id="@+id/iv_video_signal"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:src="@drawable/video_signal"
        android:contentDescription="@string/cd_play_video_attachment"
        android:visibility="gone"/>

    <ProgressBar
        android:id="@+id/pb_image_attachment"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center"/>

</FrameLayout>