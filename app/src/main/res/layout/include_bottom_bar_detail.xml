<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_bottom_bar_detail"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:gravity="center_vertical"
    android:layout_gravity="bottom"
    android:orientation="horizontal">

    <CheckBox
        android:id="@+id/cb_quick_remind"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_marginLeft="12dp"
        android:theme="@style/EverythingDoneTheme.Detail.CheckBox"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="4dp"
        android:layout_marginLeft="4dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/tv_remind_me"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:text="@string/l10n_reminder_label"/>

        <!-- Phase 8: ripple shape + colour are installed programmatically in
             DetailActivity (setupQuickRemindRipple / applyForegroundColors)
             so the corner radius matches the laid-out height (pill =
             height/2) and the ripple tint adapts to the thing's luminance. -->
        <!-- 提醒标签和时间值独立展示，避免固定动词位置限制不同语言的语序。
             负边距抵消部分内边距，让时间按钮贴近标签，同时保留点击涟漪。 -->
        <FrameLayout
            android:id="@+id/fl_quick_remind_as_bt"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_marginStart="-8dp"
            android:layout_marginLeft="-8dp"
            android:layout_marginEnd="16dp"
            android:layout_marginRight="16dp">

            <TextView
                android:id="@+id/tv_quick_remind"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:textStyle="normal"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:singleLine="true"
                android:background="@drawable/underline"/>

        </FrameLayout>

    </LinearLayout>

    <!-- Phase 8: fake FAB — 40dp oval (background = bg_fab_circle_accent),
         foreground RippleDrawable installed in DetailActivity.initUiStartDoing
         for the circular tap feedback. Margins match the home screen's
         FloatingActionButton end-margin (@dimen/fab_margin = 16dp on v21+);
         vertically centered in the 56dp bar. -->
    <FrameLayout
        android:id="@+id/fl_start_doing_as_bt"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="@dimen/fab_margin"
        android:layout_marginRight="@dimen/fab_margin"
        android:background="@android:color/transparent"
        android:elevation="2dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/iv_doing_detail"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:contentDescription="@string/start_doing_full_title"/>

    </FrameLayout>

</LinearLayout>
