<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 8: "fake FAB" — a 40dp FrameLayout clipped to an oval outline, with a
     RippleDrawable foreground so the ripple draws ON TOP of any child
     (background colour or gradient). Replaces the previous
     FloatingActionButton + overlay ImageView combo, which lost its ripple
     because the overlay sibling sat above the FAB.
     Children: a background View carrying the colour/gradient drawable, and a
     centered ImageView for the picked-state checkmark. Outline + ripple
     foreground are installed in code (FabViewHolder / GradientOrientationDialogFragment.bind). -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fl_color_cell"
    android:layout_width="40dp"
    android:layout_height="40dp"
    android:clickable="true"
    android:focusable="true">

    <View
        android:id="@+id/v_color_cell_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <ImageView
        android:id="@+id/iv_color_cell_check"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="center"
        android:visibility="gone"
        android:contentDescription="@null"/>

</FrameLayout>
