<?xml version="1.0" encoding="utf-8"?>
<!--
  控件与布局样式对齐「空间照片效果」与「粒子动画设置」两页：卡片分组 + 18dp 组标题、
  56dp 的「标题 16sp 靠左 + 读数 14sp 靠右」行、全宽 SeekBar。滑动条两端的对齐由
  ThingCardAppearanceSettingsActivity.alignSliderToTextEdges 在代码里设内边距，与
  ParticleTuningActivity 同一套。
  按内容形态分两组（内容文本 / 清单项），组内两行是卡片宽度的两个档位——这样行标题
  只有 8 个字，56dp 单行放得下右侧读数。见
  docs/features/thing-card-content-limits/decisions.md。
-->
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_chrome_surface"
    tools:context="com.ywwynm.everythingdone.activities.ThingCardAppearanceSettingsActivity">

    <View
        android:id="@+id/view_status_bar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@android:color/transparent"/>

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/actionbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_below="@id/view_status_bar"
        android:background="@android:color/transparent"
        android:theme="@style/EverythingDoneTheme.AppAccentToolbar"
        app:contentInsetStart="72dp"
        app:titleTextColor="@color/black_54p"/>

    <ScrollView
        android:id="@+id/sv_thing_card_appearance_settings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/actionbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/settings_card_margin_side"
                android:layout_marginRight="@dimen/settings_card_margin_side"
                android:layout_marginTop="@dimen/settings_card_margin_top"
                app:contentPaddingBottom="10dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/app_chrome_surface_elevated">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_title_group_content_lines"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:layout_marginLeft="18dp"
                        android:layout_marginRight="18dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_vertical"
                        android:textColor="@color/app_chrome_on_surface_secondary"
                        android:textSize="14sp"
                        android:text="@string/thing_card_appearance_content_max_lines"/>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentLeft="true"
                            android:layout_centerVertical="true"
                            android:text="@string/thing_card_appearance_settings_span_normal"
                            android:textSize="16sp"/>

                        <TextView
                            android:id="@+id/tv_content_lines_normal_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentRight="true"
                            android:layout_centerVertical="true"
                            android:textSize="14sp"
                            tools:text="9"/>

                    </RelativeLayout>

                    <SeekBar
                        android:id="@+id/sb_content_lines_normal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"/>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentLeft="true"
                            android:layout_centerVertical="true"
                            android:text="@string/thing_card_appearance_settings_span_full"
                            android:textSize="16sp"/>

                        <TextView
                            android:id="@+id/tv_content_lines_full_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentRight="true"
                            android:layout_centerVertical="true"
                            android:textSize="14sp"
                            tools:text="16"/>

                    </RelativeLayout>

                    <SeekBar
                        android:id="@+id/sb_content_lines_full"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/settings_card_margin_side"
                android:layout_marginRight="@dimen/settings_card_margin_side"
                android:layout_marginTop="@dimen/settings_card_margin_top"
                android:layout_marginBottom="@dimen/settings_card_margin_top"
                app:contentPaddingBottom="10dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/app_chrome_surface_elevated">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_title_group_checklist_items"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:layout_marginLeft="18dp"
                        android:layout_marginRight="18dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_vertical"
                        android:textColor="@color/app_chrome_on_surface_secondary"
                        android:textSize="14sp"
                        android:text="@string/thing_card_appearance_checklist_max_items"/>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentLeft="true"
                            android:layout_centerVertical="true"
                            android:text="@string/thing_card_appearance_settings_span_normal"
                            android:textSize="16sp"/>

                        <TextView
                            android:id="@+id/tv_checklist_items_normal_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentRight="true"
                            android:layout_centerVertical="true"
                            android:textSize="14sp"
                            tools:text="8"/>

                    </RelativeLayout>

                    <SeekBar
                        android:id="@+id/sb_checklist_items_normal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"/>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentLeft="true"
                            android:layout_centerVertical="true"
                            android:text="@string/thing_card_appearance_settings_span_full"
                            android:textSize="16sp"/>

                        <TextView
                            android:id="@+id/tv_checklist_items_full_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentRight="true"
                            android:layout_centerVertical="true"
                            android:textSize="14sp"
                            tools:text="12"/>

                    </RelativeLayout>

                    <SeekBar
                        android:id="@+id/sb_checklist_items_full"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

</RelativeLayout>
