<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fl_image_attachment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:foreground="@drawable/selectable_item_background_light">

    <ImageView
        android:id="@+id/iv_image_attachment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@string/cd_image_attachment"/>

    <ImageView
        android:id="@+id/iv_video_signal"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_video_signal"
        android:contentDescription="@string/cd_video_attachment"
        android:alpha="0.86"
        android:visibility="gone"/>

    <ImageView
        android:id="@+id/iv_edit_image_attachment_appearance"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="center"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="43dp"
        android:layout_marginBottom="3dp"
        android:src="@drawable/ic_thing_card_image_placement"
        android:contentDescription="@string/cd_edit_image_attachment_appearance"
        android:background="@drawable/ripple_attachment_icon_circle_light"
        android:visibility="gone"/>

    <ImageView
        android:id="@+id/iv_delete_image_attachment"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="center"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="3dp"
        android:layout_marginBottom="3dp"
        android:src="@drawable/delete_image_checklist"
        android:contentDescription="@string/cd_delete_image_attachment"
        android:background="@drawable/ripple_attachment_icon_circle_light"/>

    <!-- 左下角媒体标识（实况 / HDR / GIF），与右下角两个按钮在 y 方向居中；按需显示、可多显。 -->
    <LinearLayout
        android:id="@+id/ll_media_badges"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="3dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <com.ywwynm.everythingdone.views.KnockoutTextBadge
            android:id="@+id/tv_badge_hdr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="@string/hdr_badge_text"
            android:visibility="gone"/>

        <com.ywwynm.everythingdone.views.KnockoutTextBadge
            android:id="@+id/tv_badge_gif"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="@string/media_badge_gif"
            android:visibility="gone"/>

        <ImageView
            android:id="@+id/iv_badge_live"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_live_badge"
            android:alpha="0.76"
            android:scaleType="fitCenter"
            android:contentDescription="@string/cd_motion_photo"
            android:visibility="gone"/>

    </LinearLayout>

    <ProgressBar
        android:id="@+id/pb_image_attachment"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"/>

</FrameLayout>
