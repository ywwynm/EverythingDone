<?xml version="1.0" encoding="utf-8"?>
<!-- BaseDialogFragment 以 null parent 充气：根节点 layout_width/height 会被丢弃，
     必须用 minWidth/minHeight 声明固有尺寸，否则 FrameLayout 叠层会塌到最高子项（按钮行 96dp）。 -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="280dp"
    android:layout_height="420dp"
    android:minWidth="280dp"
    android:minHeight="420dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Voice Waveform：波浪水体（FableSol 方案），铺满全区，绘制在文字与按钮之下。
         高度 420dp 对齐 Fable 逻辑坐标 HEIGHT_DP；宽度随上方 TimelyClockView 自适应。 -->
    <com.ywwynm.everythingdone.views.recording.fablesol.WaveVisualizerFableSolHost
        android:id="@+id/voice_visualizer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <com.github.adnansm.timelytextview.TimelyClockView
        android:id="@+id/clock_record_audio"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginStart="24dp"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="24dp"
        android:layout_marginRight="24dp"/>

    <LinearLayout
        android:id="@+id/ll_audio_input"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginStart="24dp"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="84dp"
        android:layout_marginEnd="24dp"
        android:layout_marginRight="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_audio_input_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/audio_input_label"
            android:textColor="@color/app_chrome_on_surface_hint"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/ll_audio_input_capsule"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minWidth="92dp"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/tv_audio_input_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/app_chrome_on_surface_secondary"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="麦克风+系统" />

            <ImageView
                android:id="@+id/iv_audio_input_triangle"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/cd_choose_audio_input"
                android:src="@drawable/ic_dropdown" />

        </LinearLayout>

    </LinearLayout>

    <!-- 宽度 wrap + 水平居中：文本块整体在 Dialog 里居中放置，块内多行按 start
         对齐（不做行级居中）。maxWidth 由代码按 Dialog 定型宽减边距钳制。
         liveRegion=polite：授权撤销、存储失败等异步提示出现/变化时 TalkBack 主动
         播报，不需要用户重新导航到这行文本。 -->
    <TextView
        android:id="@+id/tv_audio_input_notice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginStart="36dp"
        android:layout_marginLeft="36dp"
        android:layout_marginTop="136dp"
        android:layout_marginEnd="36dp"
        android:layout_marginRight="36dp"
        android:gravity="start"
        android:includeFontPadding="false"
        android:lineSpacingExtra="1dp"
        android:maxLines="3"
        android:textColor="@color/app_chrome_on_surface_secondary"
        android:textSize="11sp"
        android:visibility="gone"
        tools:text="未检测到可捕获的系统音频，部分 App 可能禁止捕获"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/ll_audio_file_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginStart="24dp"
        android:layout_marginLeft="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginRight="24dp"
        android:translationY="-72dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <EditText
            android:id="@+id/et_audio_file_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="16sp"
            android:singleLine="true"
            android:textColor="@color/app_chrome_on_surface_secondary"
            android:textColorHint="@color/app_chrome_on_surface_hint"
            android:textCursorDrawable="@null"
            android:imeOptions="actionDone"
            android:selectAllOnFocus="true"
            android:hint="@string/input_file_name"/>

        <TextView
            android:id="@+id/tv_audio_file_postfix"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=".wav"
            android:textColor="@color/app_chrome_on_surface_secondary"
            android:textSize="16sp"
            tools:ignore="HardcodedText"/>

    </LinearLayout>

    <!-- clipChildren=false：FAB 的 4dp 高程阴影画在自身边界之外，按钮行是 wrap_content，
         不关裁剪的话准备态只剩主按钮时四周的阴影会被切掉。 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="96dp"
        android:layout_gravity="bottom|center_horizontal"
        android:clipChildren="false"
        android:clipToPadding="false">

        <ImageView
            android:id="@+id/iv_re_recording_audio"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerInside"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="@dimen/iv_fab_audio_margin"
            android:layout_marginRight="@dimen/iv_fab_audio_margin"
            android:padding="8dp"
            android:src="@drawable/act_re_recording_audio"
            android:tint="@color/app_chrome_control_unchecked"
            android:contentDescription="@string/cd_re_recording_audio"
            android:visibility="gone"
            android:alpha="0"/>

        <ImageView
            android:id="@+id/iv_record_main_action"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center_vertical"
            android:elevation="4dp"
            android:padding="16dp"
            android:scaleType="centerInside"
            android:src="@drawable/act_start_recording_audio"
            android:contentDescription="@string/cd_start_record_audio"
            android:clickable="true"
            android:focusable="true"/>

        <!-- 保存并导出水体视频：与对号 FAB 并列，使用补全左、上画框的 Material
             video_frame_save 图标。
             只在停止态出现（alpha=0 起步，recordingToStopped 里淡入）。 -->
        <ImageView
            android:id="@+id/iv_export_fablesol_video"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/iv_fab_audio_margin"
            android:layout_marginLeft="@dimen/iv_fab_audio_margin"
            android:elevation="4dp"
            android:padding="18dp"
            android:scaleType="centerInside"
            android:src="@drawable/act_fablesol_export_video"
            android:contentDescription="@string/cd_export_fablesol_video"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:alpha="0"/>

        <ImageView
            android:id="@+id/iv_cancel_recording_audio"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerInside"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/iv_fab_audio_margin"
            android:layout_marginLeft="@dimen/iv_fab_audio_margin"
            android:padding="8dp"
            android:src="@drawable/act_cancel_recording_audio"
            android:tint="@color/app_chrome_control_unchecked"
            android:contentDescription="@string/cd_cancel_recording_audio"
            android:visibility="gone"
            android:alpha="0"/>

    </LinearLayout>

</FrameLayout>
