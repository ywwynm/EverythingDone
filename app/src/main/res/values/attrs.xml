<?xml version="1.0" encoding="utf-8"?>
<resources>

    <declare-styleable name="VoiceVisualizer">
        <attr name="numColumns" format="integer" />
        <attr name="renderColor" format="color" />
        <attr name="renderRange">
            <enum name="top" value="0" />
            <enum name="bottom" value="1" />
            <enum name="both" value="2" />
        </attr>
        <attr name="renderType">
            <flag name="bar" value="0x1" />
            <flag name="pixel" value="0x2" />
            <flag name="fade" value="0x4" />
        </attr>
    </declare-styleable>

    <declare-styleable name="PatternLockView">
        <attr name="pathColor" format="color"/>
        <attr name="wrongColor" format="color"/>
        <attr name="correctColor" format="color"/>
    </declare-styleable>

    <declare-styleable name="ShiningBorder">
        <attr name="strokeWidth" format="dimension"/>
        <attr name="strokeCornerRadius" format="dimension"/>
        <attr name="animationDuration" format="integer"/>
        <attr name="repeatAnimation" format="boolean"/>
        <attr name="animationDirection" format="enum">
            <enum name="clockwise" value="0"/>
            <enum name="anticlockwise" value="1"/>
        </attr>
        <attr name="remainOrdinaryPath" format="boolean"/>
    </declare-styleable>

</resources>